# Godot 4 (.NET) ignore rules

# Godot per-project cache / imported assets
.godot/
.import/
*.translation

# Mono / .NET build output
.mono/
bin/
obj/
*.user

# Export artifacts
export.cfg
export_presets.cfg
build/
dist/

# Crash & log dumps
mono_crash.*.json
logs/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vs/
.vscode/

# Claude Code personal settings
.claude/settings.local.json

# Throwaway render output from tools/*.gd harnesses (agent-ergonomics pass).
# The .gdignore inside keeps Godot from importing stray PNGs as textures and IS tracked;
# the PNGs themselves are disposable and were repeatedly caught in `git checkout` churn.
tools/shots/*.png

# Quaternius pack source textures (2026-08-08). 132 MB of 4K PNGs that NOTHING references — each
# assets/library/<pack>/ folder ships its own game-resolution textures beside the models, and those
# are what the .gltf files load. Kept on disk for a future retexturing pass, out of git history.
assets/library/_source_textures/
