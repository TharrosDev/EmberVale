# Godot 4 (.NET) ignore rules

# Godot per-project cache / imported assets
.godot/
.import/
*.translation

# Mono / .NET build output
.mono/
bin/
obj/
*.user

# Export artifacts
export.cfg
export_presets.cfg
build/
dist/

# Crash & log dumps
mono_crash.*.json
logs/
artifacts/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vs/
.vscode/

# Python tooling caches are generated locally and never belong in source control.
__pycache__/
*.pyc

# Claude Code personal settings
.claude/settings.local.json
# Godot-MCP generates a SKILL.md per tool under .claude/skills/ when the editor connects.
# They are a local mirror of the addon's tool list, regenerated on demand, and they churn on
# every connect -- not repository content.
.claude/skills/

# Throwaway render output from tools/*.gd harnesses (agent-ergonomics pass).
# The .gdignore inside keeps Godot from importing stray PNGs as textures and IS tracked;
# the PNGs themselves are disposable and were repeatedly caught in `git checkout` churn.
tools/shots/*.png
# world_shots.gd writes 150 PNGs per run under tools/shots/world/. Same rule, one directory down.
tools/shots/**/*.png

# Quaternius pack source textures (2026-08-08). 132 MB of 4K PNGs that NOTHING references — each
# assets/library/<pack>/ folder ships its own game-resolution textures beside the models, and those
# are what the .gltf files load. Kept on disk for a future retexturing pass, out of git history.
assets/library/_source_textures/

# Nature pack 4K source textures (2026-08-08). Same reason as the line above: nothing references them.
assets/library/_source_textures_nature/

# Godot-MCP local server binary, credentials and per-project MCP state (38G tooling,
# 2026-08-09). Downloaded per machine by `godot-cli install-plugin --with-server`; a 40 MB
# binary and a credential file have no business in the history.
.ai-game-dev/
.godot-mcp/

# Local 3D audit output. `python tools/assets.py audit` writes a timestamped run here; it is
# regenerable evidence for the working tree in front of you, not repository history. Committing
# these is what grew reports/3d/ to 400 MB across nine near-identical snapshots.
reports/3d/runs/
