[gd_scene format=3]

; A patch of trampled ash (campaign: the herd's ground, WR-spec1-10..12, 31, 32). Two overlapping dark discs,
; sunk a hair into the ground so the edge reads as a stain rather than a plate. Scale it per use; it is
; decor and carries no collider.

[sub_resource type="StandardMaterial3D" id="Mat_ash"]
albedo_color = Color(0.17, 0.145, 0.125, 1)
roughness = 1

[sub_resource type="StandardMaterial3D" id="Mat_ash_light"]
albedo_color = Color(0.25, 0.215, 0.185, 1)
roughness = 1

[sub_resource type="CylinderMesh" id="Mesh_disc"]
top_radius = 1.0
bottom_radius = 1.0
height = 0.02
radial_segments = 14

[node name="AshPatch" type="Node3D"]

[node name="DiscA" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.005, 0)
mesh = SubResource("Mesh_disc")
material_override = SubResource("Mat_ash")

[node name="DiscB" type="MeshInstance3D" parent="."]
transform = Transform3D(0.72, 0, 0, 0, 1, 0, 0, 0, 0.58, 0.28, 0.012, -0.12)
mesh = SubResource("Mesh_disc")
