albedo_tint = Color(0.95, 0.88, 0.9, 1)

; The challenge brazier, just inside the south gap. The Knight rises at the ring's centre (37, -37):
; brazier (37, -20) plus SpawnOffset (0, 0, -17). Move one and move the other.
[node name="Brazier" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 37, 0, -20)
script = ExtResource("2_entity")
DisplayName = "The Knight's Brazier"

