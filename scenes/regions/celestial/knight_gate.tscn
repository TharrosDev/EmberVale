; ====================================================================================================
; THE KNIGHT'S GATE (the finish run, Act IV) — where the Ashen Knight is fought.
;
; The last gate before the Ash Throne, at the far end of the only bridge over the void rift. The ring
; stands on the gate terrace (region_spec_celestial.py GATE, levelled flat across 48 x 44 m), centred
; at cell-local (37, -37). The road arrives through the SOUTH gap and leaves through the NORTH gap for
; the throne; the ring between is a broken circle of the gods' walls.
;
; Modelled on scenes/regions/ember_crown/arena.tscn:
;   Brazier/Summon      BossSummonComponent — the Knight rises at the ring's centre (brazier + offset)
;   Vents/VentA-D       hidden lights the phase hooks reveal
;   Phase2Hook/3Hook    ArenaHookComponent — reveal the vents at phase 2/3, reset on his death
; No AddSpawns: it is a duel, and data/bosses/AshenKnight.tres has no add waves.
;
; ⚠️ THE FIGHTING CIRCLE STAYS BARE (the Iron King arena's rule). Everything here is on the rim.
; ====================================================================================================
[sub_resource type="NavigationMesh" id="NavMesh_knight_gate"]
geometry_parsed_geometry_type = 1
cell_size = 0.4
cell_height = 0.3
agent_height = 1.8
agent_radius = 0.8
agent_max_climb = 0.3
agent_max_slope = 40.0

[sub_resource type="BoxShape3D" id="Shape_brazier"]
size = Vector3(1, 1.4, 1)

[sub_resource type="CapsuleShape3D" id="WC_Capsule_0p45_1p5"]
radius = 0.45
height = 1.5

[node name="KnightGateCell" type="Node3D"]

[node name="Nav" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("NavMesh_knight_gate")

[node name="NavBaker" type="Node" parent="Nav"]
script = ExtResource("1_navbaker")

; The gate pillars: the two pairs that flank the south and north gaps, the only whole stones left.
