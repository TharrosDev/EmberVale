; Base scene for a dragon's lair cell (Phase 35F). 35D and 35E each hand-authored this structure and
; both flagged that a third roost should promote it instead of copying it again — this is that
; promotion. An individual roost inherits this scene, overrides the RoostCell knobs (floor size and
; colours), the Nest's PersistentId/DisplayName and the Lair's TemplateId, and adds its own props as
; children of Nav (geometry outside the navigation region is not carved into the bake).
[gd_scene load_steps=7 format=3 uid="uid://crgnroostbase0"]

[ext_resource type="Script" path="res://src/World/RoostCell.cs" id="1_roost"]
[ext_resource type="Script" path="res://src/World/CellNavBaker.cs" id="2_navbaker"]
[ext_resource type="Script" path="res://src/Entities/Entity.cs" id="3_entity"]
[ext_resource type="Script" path="res://src/Enemies/LairSpawnComponent.cs" id="4_lair"]

; agent_* dims stay on the 0.25 voxel grid (Phase 27A) to avoid precision warnings, and the geometry
; is parsed from static colliders — never visual meshes, which force a GPU→CPU readback hitch.
[sub_resource type="NavigationMesh" id="NavMesh_roost"]
geometry_parsed_geometry_type = 1
cell_size = 0.25
cell_height = 0.25
agent_height = 1.75
agent_radius = 0.5
agent_max_climb = 0.5

; Sized by RoostCell at load — the value here is only what the editor draws.
[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(90, 0.5, 90)

[sub_resource type="BoxShape3D" id="Shape_floor"]
size = Vector3(90, 0.5, 90)

[node name="RoostCell" type="Node3D"]
script = ExtResource("1_roost")

[node name="Nav" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("NavMesh_roost")

[node name="NavBaker" type="Node" parent="Nav"]
script = ExtResource("2_navbaker")

[node name="Floor" type="MeshInstance3D" parent="Nav"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.25, 0)
mesh = SubResource("BoxMesh_floor")

[node name="FloorCol" type="StaticBody3D" parent="Nav"]

[node name="Shape" type="CollisionShape3D" parent="Nav/FloorCol"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.25, 0)
shape = SubResource("Shape_floor")

; Each roost MUST override PersistentId — LairSpawnComponent.SaveId derives from it, so two roosts
; sharing one means killing either marks both defeated.
[node name="Nest" type="Node3D" parent="."]
script = ExtResource("3_entity")
DisplayName = "Roost"
PersistentId = "lair.roost"

[node name="Lair" type="Node" parent="Nest"]
script = ExtResource("4_lair")
SpawnOffset = Vector3(0, 0.5, 0)
