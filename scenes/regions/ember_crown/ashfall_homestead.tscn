PropertyId = "property.ember_crown.cottage"

; --- 37B: the stash -----------------------------------------------------------------------------------
; ⚠️ PersistentId UNCHANGED from 37B. The chest IS its inventory (`inventory:<PersistentId>`), so this
; is the same chest a player filled before 37E moved it, and renaming it would empty their save.
; Capacity stays on the node, not the property: InventoryComponent.Load clamps to Capacity, so a
; capacity applied after the save manager's mid-load restore would silently eat the overflow.

[node name="CottageChest" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 11.4, 0, -3.2)
script = ExtResource("1_entity")
DisplayName = "Storage Chest"
PersistentId = "ember_crown.cottage_chest"

[node name="Mesh" parent="CottageChest" instance=ExtResource("9_chest")]

