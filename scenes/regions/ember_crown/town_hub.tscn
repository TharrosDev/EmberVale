; --- 37B: the Ashfall Cottage's stash -----------------------------------------
; Moved in 37D off the outside wall of BuildingSW and into the cottage's own room, against the west
; wall (interior edge x = -26) beside the door.
;
; The chest IS its inventory: an authored PersistentId is all the persistence 37B needs, since
; InventoryComponent already saves as inventory:<PersistentId> and CellPersistenceDirector already
; carries it across cell unload/reload. Capacity lives on that node rather than on the property
; resource because InventoryComponent.Load clamps to Capacity — a capacity applied after the save
; manager's mid-load restore would silently eat the overflow.
;
; Reuses prp_cache_chest.glb (already imported and credited for the 30J supply cache) rather than
; sourcing another model; the box fallback matches the deed post's greybox.

[node name="CottageChest" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -25, 0, -18.5)
script = ExtResource("1_entity")
DisplayName = "Storage Chest"
PersistentId = "ember_crown.cottage_chest"

[node name="Mesh" parent="CottageChest" instance=ExtResource("33_chest")]

[node name="Collider" type="StaticBody3D" parent="CottageChest"]

[node name="Shape" type="CollisionShape3D" parent="CottageChest/Collider"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 0)
shape = SubResource("Shape_chest")

[node name="Inventory" type="Node" parent="CottageChest"]
