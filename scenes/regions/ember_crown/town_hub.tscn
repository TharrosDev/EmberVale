[sub_resource type="BoxShape3D" id="Shape_workbench"]
size = Vector3(2.02, 0.89, 1.02)

[sub_resource type="CapsuleShape3D" id="wa_cap_0p4_1p8"]
radius = 0.4
height = 1.8

; --- The 2026-08-28 layout rebuild: the Kingsway and the two yards. -------------------------------------------------------
; Ground skins only — 6 cm slabs with NO collider, exactly as embermarket authors them (a 6 cm lip is
; something the player catches on rather than climbs, and a collider here would be carved into the
; navmesh as a step NPCs path around for no visible reason). They exist so the road the player walks
; is VISIBLE as a road; the terrain underneath is authored to match in EmberCrown.tres.
[node name="TownHubCell" type="Node3D"]
metadata/content_offset = Vector2(25, 7.5)

