emission = Color(1, 0.45, 0.12, 1)
emission_energy_multiplier = 3.0

[sub_resource type="SphereMesh" id="Mesh_coals"]
radius = 0.13
height = 0.26
radial_segments = 8
rings = 4

; Ground skin. NO COLLIDER (see the step-up note above): a 6 cm lip is something the player catches on.
; The 2026-08-28 layout rebuild: seven worked surfaces instead of one 34 x 16 band. Together they form a LOOP — yard,
; haul road, cut, pit head, spoil track, spoil link, back to the yard — so the mine is somewhere you
; go round rather than a corridor you go up and come back down.
