[ext_resource type="PackedScene" path="res://assets/models/characters/npc_townswoman.glb" id="31_townswoman"]

; THE EMBERDEEP MINE (Phase 38N1) — the realm's first PRODUCTION settlement, and the second market the
; economy has been waiting for since 38F.
;
; It exists to be the other side of the Embermarket's prices. Ash Dunmore has been saying since 38L
; that "there's a mine east of here they say is opening again. Emberdeep. If it does, I'll be buying
; ore by the cartload"; this is that mine, and the two shops in it are deliberately a SOURCE and a
; SINK rather than two more stalls:
;   Bregan Holt weighs ore at the lowest markup in the realm (1.15) and barely buys.
;   Marta Quill pays the most for food anywhere (0.62 fraction, `food` specialty) and sells nothing.
; A settlement whose merchants accepted everything would be the town square with different scenery,
; which is the whole failure 38G was parked to avoid.
;
; ⚠️ The cell is placed at Center (99, 0, -10), abutting the arena's 36 m floor which ends at x = 73:
; a 52 m floor centred at x = 99 starts exactly there. Every transform in this file is LOCAL. The road
; in is from the WEST, so local -x is toward the town and the mine head sits against the east wall.
;
; ⚠️ EVERYTHING STATIC PARENTS TO Nav — geometry outside the NavigationRegion3D is not carved into the
; navmesh, so an NPC would walk straight through the mine head. The two merchants deliberately do not.
;
; ⚠️ NO RAISED GROUND (38K). CharacterBody3D has no step-up, so the yard is flat and its height comes
; from a 6 m mine head, 2.2 m boulders and the ore heaps — from props, never from terrain.
;
; LAYOUT, west (the road from the arena) to east (the seam):
;   x -26..-14  the approach: dead pines, rock, the waystone.
;   x -14..+2   the yard: Bregan's weighing stand (north side) and Marta's company store (south),
;               with the carts, crates, sacks and the shift's cook-fire between them.
;   x  +2..+20  the workings: ore heaps, timber for pit props, spoil boulders, and the mine head
;               itself facing west into the yard.

[sub_resource type="NavigationMesh" id="NavMesh_mine"]
geometry_parsed_geometry_type = 1
cell_size = 0.25
cell_height = 0.25
agent_height = 1.75
agent_radius = 0.5
agent_max_climb = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(52, 0.5, 52)

[sub_resource type="BoxShape3D" id="Shape_floor"]
size = Vector3(52, 0.5, 52)

; Darker and browner than any ground in the game so far — spoil, not soil. The mine reads as a place
; that has been dug over rather than built on.
[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.24, 0.22, 0.19, 1)
roughness = 0.97

; The hardstanding the carts stand on, and the one lighter surface: the route from the road to the
; mine head, so the yard is legible from the seam.
[sub_resource type="StandardMaterial3D" id="Mat_yard"]
albedo_color = Color(0.38, 0.35, 0.3, 1)
roughness = 0.92

; The ONE warm accent (ART_STYLE §7): coals in the braziers and under the cook-fire. Nothing else here
; glows, which is what makes a lit brazier read as somewhere people are.
[sub_resource type="StandardMaterial3D" id="Mat_ember"]
albedo_color = Color(0.62, 0.22, 0.08, 1)
emission_enabled = true
emission = Color(1, 0.45, 0.12, 1)
emission_energy_multiplier = 3.0

[sub_resource type="SphereMesh" id="Mesh_coals"]
radius = 0.13
height = 0.26
radial_segments = 8
rings = 4

; Ground skin. NO COLLIDER (see the step-up note above): a 6 cm lip is something the player catches on.
[sub_resource type="BoxMesh" id="BoxMesh_yard"]
size = Vector3(34, 0.06, 16)

