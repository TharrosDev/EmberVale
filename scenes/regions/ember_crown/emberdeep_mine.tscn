; ====================================================================================================
; GROUND COVER (38B) - a worked site, so no meadow - mushrooms and pebbles in the damp corners, and grass
; only out at the fenceline where nobody walks.
;
; Style "industrial", scattered by tools/dress_cell.py (seed 38), which reads this cell's OWN node
; positions out of this file and treats them as keep-outs, so nothing lands inside a building or on
; a merchant. Regenerate with:
;     python tools/dress_cell.py scenes/regions/ember_crown/emberdeep_mine.tscn industrial 32
;
; WARNING EVERY NODE BELOW PARENTS TO THE CELL ROOT, NOT TO Nav, AND CARRIES NO COLLIDER. The navmesh
; parses static colliders only, so a collider-less tuft could not carve it from inside Nav either -
; but parenting out states the intent where a reader will see it. Grass an NPC paths around is worse
; than no grass.
;
; WARNING SCALE LIVES IN THE .import. The nature megakit ships its trees at 1 m = 1 unit and its
; ground cover four to ten times life size. Correct a size in the prop's .import so every cell gets
; it, never in a transform here. docs/ASSET_POLICY.md section 0.3.
; ====================================================================================================


[node name="MapPin" type="Node3D" parent="."]
position = Vector3(-10, 0, -1.5)
script = ExtResource("maploc_39_5a")
LocationId = "location.emberdeep.mine"

[node name="MapPin" type="Node3D" parent="MineWaystone"]
script = ExtResource("maploc_39_5a")
LocationId = "location.emberdeep.waystone"

[node name="MapPin" type="Node3D" parent="Bregan"]
script = ExtResource("maploc_39_5a")
LocationId = "location.emberdeep.factor"

[node name="MapPin" type="Node3D" parent="Marta"]
script = ExtResource("maploc_39_5a")
LocationId = "location.emberdeep.quartermaster"

; ── THE UNDERCROFT (Phase 42B) ────────────────────────────────────────────────────────────────────
; The Emberbound's hub, and the one that is NOT a building. A pillared chamber cut off the pithead
; floor (Area_mine_pithead, centre (18, -9), radius (8, 9), levelled to y = -3.5), so reaching it
; means going DOWN three and a half metres into the workings — which is the whole of its concealment
; and cost nothing to build, because the pit was already there.
; ⚠️ Its map pin does NOT reveal with the cell. Every other hub in the realm does; this one has to be
; walked to. The flag gate a concealed order eventually wants is 42K's, along with the initiation
; that would set it — RequiredFlagId stays empty here rather than naming a flag nothing can set.
