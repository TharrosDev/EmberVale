size = Vector3(36, 0.5, 36)

; ⚠️ THE FLOOR IS THE BIGGEST SINGLE THING ON SCREEN AND IT WAS A FLAT COLOUR. A 36 x 36 m plane of
; albedo 0.22 grey is most of what the eye sees during the fight. It carries the kit's brick texture
; now, tiled 9x, which costs one material and no extra nodes — 324 floor tiles would have been the
; obvious answer and is 324 nodes for the same pixels.
[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.62, 0.58, 0.54, 1)
albedo_texture = ExtResource("17_brick")
normal_enabled = true
normal_texture = ExtResource("18_brick_n")
uv1_scale = Vector3(26, 26, 26)
roughness = 0.95

