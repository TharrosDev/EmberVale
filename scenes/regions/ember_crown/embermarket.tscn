; --- The travel node. Deliberately OUTSIDE Nav ------------------------------------------------------
; It is an Entity with its own collider, and the pattern town_hub's waystone established: the component
; records where the PLAYER stands when attuning, never the post's own position, because fast travel that
; lands on the post's collider traps the player inside it.
;
; ⚠️ TravelName is a LOCALE KEY, not prose. TravelNodeComponent now resolves it through Loc.T (the Phase
; 25 waystone's authored English still renders, because Loc.T on a plain string returns it unchanged).

[node name="MarketWaystone" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -18)
script = ExtResource("2_entity")
DisplayName = "Embermarket Waystone"

[node name="Model" parent="MarketWaystone" instance=ExtResource("7_waystone")]

[node name="Collider" type="StaticBody3D" parent="MarketWaystone"]

[node name="Shape" type="CollisionShape3D" parent="MarketWaystone/Collider"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
shape = SubResource("Shape_waystone")

[node name="Travel" type="Node" parent="MarketWaystone"]
script = ExtResource("3_travel")
Id = "travel.ember_crown.embermarket"
TravelName = "travel.ember_crown.embermarket.name"
RegionId = "region.ember_crown"
