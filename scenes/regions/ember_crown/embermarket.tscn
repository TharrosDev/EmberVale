shape = SubResource("Shape_floor")

; The aisle is a thin slab sitting ON the floor with NO collider of its own — a 6cm step the player
; would otherwise catch on, and a collider here would be carved into the navmesh as a lip that NPCs
; path around for no visible reason.
[node name="Aisle" type="MeshInstance3D" parent="Nav"]
