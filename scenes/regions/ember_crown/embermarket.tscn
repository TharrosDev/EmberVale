mesh = SubResource("BoxMesh_floor")
surface_material_override/0 = SubResource("Mat_floor")

[node name="FloorCol" type="StaticBody3D" parent="Nav"]

[node name="Shape" type="CollisionShape3D" parent="Nav/FloorCol"]
