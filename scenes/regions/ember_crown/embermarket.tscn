[sub_resource type="BoxMesh" id="BoxMesh_plaza"]
size = Vector3(12, 0.06, 12)

[sub_resource type="BoxMesh" id="BoxMesh_plaza_path"]
size = Vector3(2.5, 0.06, 4)

; --- Colliders. Every one of these is sized from the model's real bounding box, read out of the
; --- written .glb rather than guessed. The first pass's Shape_stall (3.2 x 2.4 x 3.2) was authored for
; --- a tent that is actually 3.29 x 2.33 x 5.61, so 2.4 m of the tent's depth had no collision at all
; --- and neither the navmesh nor the player knew it was there.
