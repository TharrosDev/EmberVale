; THE EMBERMARKET (Phase 38K, second pass) — the Ember Crown's market district, one street south of
; the town square.
;
; 38K's first pass built a cell that streamed, navigated, lit and carried a travel node, and it was
; correct and completely lifeless: seven model files in twenty-four instances, six identical tents on
; six identical crates in two mirrored rows, six identical lamps, one flat 52 m box, two materials and
; no emission anywhere. This pass keeps every one of those decisions that was load-bearing and rebuilds
; everything that was placeholder.
;
; ⚠️ THE STALL TRANSFORMS ARE A CONTRACT WITH 38L AND DO NOT MOVE. StallW1..StallE3 keep their names,
; their positions (x = ±9, z = -14 / -3 / +8) and their Counter child at local (2.2, 0, 0), because the
; playbook promised 38L that placing a merchant would be "a transform copied out of this file". Variety
; comes from a different stall MODEL and different dressing per stall — never from rotating or nudging
; a stall root, which would silently invalidate every counter offset 38L is going to copy.
;
; ⚠️ EVERYTHING STATIC PARENTS TO Nav. Geometry outside the NavigationRegion3D is not carved into the
; navmesh, so an NPC or an enemy walks straight through a stall that looks solid. NPCs and the notice
; board deliberately do NOT (see the actor block at the bottom) — only static geometry should carve.
;
; ⚠️ The cell is placed at its Center by the RegionStreamer, so every transform in this file is LOCAL to
; the market's own origin. The 37C placement bug — a point read out of a .tscn landing a cell's width
; from where it was authored — is the same mistake in the other direction.
;
; ⚠️ NOTHING IN THIS CELL IS RAISED GROUND, AND THAT IS DELIBERATE. The first draft of this pass had a
; 0.3 m plaza dais. Godot's CharacterBody3D has no step-up: MoveAndSlide climbs nothing taller than
; floor_snap_length (0.1 m by default, and this project never raises it), so a 0.3 m kerb is an
; invisible wall the player walks into, and the navmesh's agent_max_climb = 0.5 cheerfully bakes NPCs a
; path over ground the player cannot follow them onto. Every ground slab here is a 5-6 cm decorative
; skin with NO COLLIDER, exactly like the original aisle. The district's verticality comes from an
; 11 m bell tower, 8 m trees and 2.6 m awnings — from props, never from terrain.
;
; LAYOUT, north (the approach from the square) to south (the landmark that stops the eye):
;   z -26..-18  the forecourt: a paved threshold, the waystone, the market banner, two braziers, two
;               parked carts and the notice board.
;   z -18..+17  the spine: a 7 m aisle with the two stall rows facing each other across it, crossed
;               east-west at z = -8.5 so the district reads as a quarter rather than a corridor.
;   z +9..+21   the plaza, off-axis to the WEST: the well, three benches, a cook-fire and a brazier.
;               Off-axis on purpose — a plaza centred on the aisle would have to be walked through,
;               and the whole point of it is that it is somewhere you turn aside to go.
;   z +20       the bell tower, dead centre, terminating the aisle.
; Houses, fences, trees and bushes close the east and west edges; five clutter clusters sit against
; stall flanks and house walls. NOTHING enters the 7 m spine — the aisle is the navigation affordance.

[sub_resource type="NavigationMesh" id="NavMesh_market"]
geometry_parsed_geometry_type = 1
cell_size = 0.25
cell_height = 0.25
agent_height = 1.75
agent_radius = 0.5
agent_max_climb = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(52, 0.5, 52)

[sub_resource type="BoxShape3D" id="Shape_floor"]
size = Vector3(52, 0.5, 52)

; Paler and warmer than the square's packed earth — flagstones a market has been swept across for years.
[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.33, 0.3, 0.26, 1)
roughness = 0.95

; Three ground materials, all inside ART_STYLE's ~40% saturation ceiling for environment albedo. The
; aisle is the lightest so it reads as the swept route; the plaza is a colder grey so the well corner
; reads as a different room; the forecourt sits between them at the threshold.
[sub_resource type="StandardMaterial3D" id="Mat_aisle"]
albedo_color = Color(0.47, 0.44, 0.4, 1)
roughness = 0.9

[sub_resource type="StandardMaterial3D" id="Mat_plaza"]
albedo_color = Color(0.3, 0.29, 0.28, 1)
roughness = 0.85

[sub_resource type="StandardMaterial3D" id="Mat_forecourt"]
albedo_color = Color(0.38, 0.34, 0.29, 1)
roughness = 0.9

; The ONE warm accent (ART_STYLE §7: at most one, it glows and nothing else does). A coal ball inside
; each brazier bowl and one under the cauldron; the OmniLight and the ember particles are the same
; accent doing the other two jobs.
[sub_resource type="StandardMaterial3D" id="Mat_ember"]
albedo_color = Color(0.62, 0.22, 0.08, 1)
emission_enabled = true
emission = Color(1, 0.45, 0.12, 1)
emission_energy_multiplier = 3.0

[sub_resource type="SphereMesh" id="Mesh_coals"]
radius = 0.13
height = 0.26
radial_segments = 8
rings = 4

; --- Ground skins. Sizes chosen so they ABUT rather than overlap: two coplanar slabs z-fight along
; --- their seam, and that is invisible in the .tscn, so the arithmetic is written down here.
; ---   forecourt  z -26 .. -18   (13 wide, centred z = -22)
; ---   spine      z -18 .. +17   ( 7 wide, centred z = -0.5)
; ---   cross-lane x -17 .. -3.5 and +3.5 .. +17, split around the spine for the same reason
; ---   plaza      x -18 .. -6, z +9.5 .. +21.5, joined to the spine by a 2.5 m path
[sub_resource type="BoxMesh" id="BoxMesh_spine"]
size = Vector3(7, 0.06, 35)

[sub_resource type="BoxMesh" id="BoxMesh_forecourt"]
size = Vector3(13, 0.05, 8)

[sub_resource type="BoxMesh" id="BoxMesh_cross"]
