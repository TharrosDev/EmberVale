; THE EMBERMARKET (Phase 38K) — the Ember Crown's market district, one street south of the town square.
;
; This sub-phase builds the PLACE and nothing else: it streams, it navigates, it lights, and it carries a
; travel node. The twelve specialist merchants who will stand at these stalls are 38L's, and the stalls
; are laid out and named for them now (StallW1..StallE3) so that placing a vendor is a transform copied
; out of this file rather than a position guessed in the dark.
;
; ⚠️ EVERYTHING PARENTS TO Nav. Geometry outside the NavigationRegion3D is not carved into the navmesh,
; so an NPC or an enemy walks straight through a stall that looks solid. That is the trap town_hub.tscn
; already documents at the top of its own prop block, and it is repeated here because it is invisible
; until something walks through a tent.
;
; ⚠️ The cell is placed at its Center by the RegionStreamer, so every transform in this file is LOCAL to
; the market's own origin. The 37C placement bug — a point read out of a .tscn landing a cell's width
; from where it was authored — is the same mistake in the other direction.
;
; LAYOUT: a 52 x 52 flagged square. Two rows of stalls face each other across a central aisle running
; north–south (the approach from the town square), the waystone at the north end where the player enters,
; houses closing the east and west edges so the district reads as enclosed rather than as a field with
; tents on it. Six lamp posts, warm and low, on the same colour and energy as the square's so the two
; cells look like one town after dark.

[sub_resource type="NavigationMesh" id="NavMesh_market"]
geometry_parsed_geometry_type = 1
cell_size = 0.25
cell_height = 0.25
agent_height = 1.75
agent_radius = 0.5
agent_max_climb = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(52, 0.5, 52)

[sub_resource type="BoxShape3D" id="Shape_floor"]
size = Vector3(52, 0.5, 52)

; Paler and warmer than the square's packed earth — flagstones a market has been swept across for years.
[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.33, 0.3, 0.26, 1)
roughness = 0.95

; The aisle itself, a shade lighter, laid over the floor. It is the only piece of art direction in the
; cell doing navigation work: it tells the player where the stalls are before they can read a sign.
[sub_resource type="BoxMesh" id="BoxMesh_aisle"]
size = Vector3(7, 0.06, 44)

[sub_resource type="StandardMaterial3D" id="Mat_aisle"]
albedo_color = Color(0.42, 0.38, 0.32, 1)
roughness = 0.9

[sub_resource type="BoxShape3D" id="Shape_stall"]
size = Vector3(3.2, 2.4, 3.2)

[sub_resource type="BoxShape3D" id="Shape_crate"]
size = Vector3(1, 1, 1)

[sub_resource type="CylinderShape3D" id="Shape_lamp"]
