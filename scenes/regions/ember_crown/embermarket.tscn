; --- Ember VFX. Two emitters: rising motes over a fire, and a slow smoke wisp over the cook-pot.
; --- Authored here rather than built in code (SkyController.BuildRain / StatusEffectVfxComponent
; --- do theirs in C#) because these are scenery, and a cell that carries its own particles stays
; --- self-contained the way ARCHITECTURE §2.6h-2 asks cells to be.
[sub_resource type="StandardMaterial3D" id="Mat_particle_ember"]
transparency = 1
shading_mode = 0
blend_mode = 1
albedo_color = Color(1, 0.55, 0.2, 1)
emission_enabled = true
