; ====================================================================================================
; --- 38R2: the dockside bones ----------------------------------------------------------------
; The smugglers' game, running on a table in the nook between the tent and the cart. Fifty gold a
; throw, three a day, and the house wins three times in four — the arithmetic is in the .tres and
; --validate refuses a table that expects to pay.
;
; ⚠️ THE INTERACTABLE IS THE TABLE AND NOT A PERSON, WHICH IS THE OPPOSITE CALL TO 38R'S HIRE. Wren
; is hired in conversation because pressing E on a woman to buy her is a vending machine with a face.
; A throw is the other shape: three a day means three presses, and a conversation reopened for each
; one would put two clicks between the player and the dice. 38Q2's board took the same reading.
;
; ⚠️ prp_table_large rather than a fifth crate, and this one was reasoned rather than rendered: the
; cell already carries four crates, so a crate holding the district's one prompt is a "which crate is
; the game?" problem before anything is drawn. What the render DID settle is below.
;
; ⚠️ Position and yaw are the RENDERED answers. It sits clear of both fences' pitches so the district's
; three interactables never share a frame with each other.
[node name="BonesTable" type="Node3D" parent="Nav"]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 18, 0, -8)
script = ExtResource("2_entity")
DisplayName = "The Dockside Bones"

[node name="Model" parent="Nav/BonesTable" instance=ExtResource("47_bones_table")]

[node name="Collider" type="StaticBody3D" parent="Nav/BonesTable"]

[node name="Shape" type="CollisionShape3D" parent="Nav/BonesTable/Collider"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.41, 0)
shape = SubResource("Shape_bones")

[node name="Service" type="Node" parent="Nav/BonesTable"]
script = ExtResource("46_service")
ServiceId = "service.hollowreach.bones"

; ⚠️ THE TWO BARRELS ARE NOT DRESSING, THEY ARE THE READ. prp_table_large is already Bryn's order
; bench and Nessa's assay counter, so this is its THIRD use and its SECOND as an interactable — a
; player who has learned "long table = counter" walks up to this one expecting one. A seat on either
; side is the cheapest thing that says two people sit here and play, and it is the only table in the
; realm with them. The alternative was a fifth crate, which this cell cannot afford, or a new model,
; which the four packs do not have.
[node name="BonesStoolW" type="Node3D" parent="Nav"]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 16.6, 0, -8)

[node name="Model" parent="Nav/BonesStoolW" instance=ExtResource("16_barrel")]

[node name="Collider" type="StaticBody3D" parent="Nav/BonesStoolW"]

[node name="Shape" type="CollisionShape3D" parent="Nav/BonesStoolW/Collider"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.43, 0)
shape = SubResource("Shape_barrel")

[node name="BonesStoolE" type="Node3D" parent="Nav"]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 19.4, 0, -8)

[node name="Model" parent="Nav/BonesStoolE" instance=ExtResource("16_barrel")]

[node name="Collider" type="StaticBody3D" parent="Nav/BonesStoolE"]

[node name="Shape" type="CollisionShape3D" parent="Nav/BonesStoolE/Collider"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.43, 0)
shape = SubResource("Shape_barrel")

; GROUND COVER (38B) - a thin band hard against the boundary and NOTHING in the middle.
;
; Style "edges", scattered by tools/dress_cell.py (seed 38), which reads this cell's OWN node
; positions out of this file and treats them as keep-outs, so nothing lands inside a building or on
; a merchant. Regenerate with:
;     python tools/dress_cell.py scenes/regions/ember_crown/hollowreach.tscn edges 35
;
; WARNING EVERY NODE BELOW PARENTS TO THE CELL ROOT, NOT TO Nav, AND CARRIES NO COLLIDER. The navmesh
; parses static colliders only, so a collider-less tuft could not carve it from inside Nav either -
; but parenting out states the intent where a reader will see it. Grass an NPC paths around is worse
; than no grass.
;
; WARNING SCALE LIVES IN THE .import. The nature megakit ships its trees at 1 m = 1 unit and its
; ground cover four to ten times life size. Correct a size in the prop's .import so every cell gets
; it, never in a transform here. docs/ASSET_POLICY.md section 0.3.
; ====================================================================================================


