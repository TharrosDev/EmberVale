shape = SubResource("Shape_dock_house")

; ⚠️ terrain_absolute: THE ONLY NODES IN THIS CELL WHOSE Y IS A WORLD HEIGHT RATHER THAN A CLEARANCE.
; Everywhere else WorldTerrainConform adds the ground under the node — and the ground under a jetty
; is the CHANNEL FLOOR. Sunk 0.30 m they landed flush on the old flat floor; the 2026-08-29 overhaul
; cut the channels to -3.20 and took them down with it, decks 3.25 m under a declared water surface,
; where nothing reported it because a drowned prop breaks no invariant anyone had written.
;
; Y IS NOW ABSOLUTE AND IT IS THE WATERLINE THAT SETS IT, not the ground. The model's deck planks span
; +0.12..+0.33 above its origin and its posts reach -1.05 (parsed from prp_jetty.glb, whose .import
; carries root_scale 2.98 — the numbers are not the ones in the raw mesh). So Y = 0 puts the deck top
; at +0.33: 0.28 m of freeboard over the 0.05 waterline, 0.03 m above the spine it runs off — the
; flush reading the old -0.30 was reaching for — and the posts 1.10 m into the water.
; ⚠️ MOVE THE WATER'S SurfaceY AND THESE TWO MUST MOVE WITH IT. Nothing links them.
[node name="JettyNorth" type="Node3D" parent="Nav" groups=["terrain_absolute"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -8, 0, -9)

[node name="Model" parent="Nav/JettyNorth" instance=ExtResource("11_jetty")]

[node name="JettySouth" type="Node3D" parent="Nav" groups=["terrain_absolute"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0, 11)

[node name="Model" parent="Nav/JettySouth" instance=ExtResource("11_jetty")]

