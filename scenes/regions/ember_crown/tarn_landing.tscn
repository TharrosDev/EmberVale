; ====================================================================================================
; GROUND COVER (38B) - wispy grass toward the water, pebbles on the strand, ferns inland under the pines.
;
; Style "shore", scattered by tools/dress_cell.py (seed 38), which reads this cell's OWN node
; positions out of this file and treats them as keep-outs, so nothing lands inside a building or on
; a merchant. Regenerate with:
;     python tools/dress_cell.py scenes/regions/ember_crown/tarn_landing.tscn shore 32
;
; WARNING EVERY NODE BELOW PARENTS TO THE CELL ROOT, NOT TO Nav, AND CARRIES NO COLLIDER. The navmesh
; parses static colliders only, so a collider-less tuft could not carve it from inside Nav either -
; but parenting out states the intent where a reader will see it. Grass an NPC paths around is worse
; than no grass.
;
; WARNING SCALE LIVES IN THE .import. The nature megakit ships its trees at 1 m = 1 unit and its
; ground cover four to ten times life size. Correct a size in the prop's .import so every cell gets
; it, never in a transform here. docs/ASSET_POLICY.md section 0.3.
; ====================================================================================================



[node name="MapPin" type="Node3D" parent="."]
position = Vector3(-6, 0, 17)
script = ExtResource("maploc_39_5a")
LocationId = "location.tarn.landing"

[node name="MapPin" type="Node3D" parent="LandingWaystone"]
script = ExtResource("maploc_39_5a")
LocationId = "location.tarn.waystone"

[node name="MapPin" type="Node3D" parent="Wenna"]
script = ExtResource("maploc_39_5a")
LocationId = "location.tarn.curer"

[node name="MapPin" type="Node3D" parent="Odger"]
script = ExtResource("maploc_39_5a")
LocationId = "location.tarn.chandler"

; Elyndra's waystone sits at the landing edge among the docks, nets and shore plants: a working
; waterside place where seasons and wildlife have a visible daily consequence.
;
; ⚠️ AT THE EDGE, NOT IN IT — IT WAS IN IT. Authored at local (-13, 13) on the old flat floor; the
; 2026-08-29 overhaul cut the tarn to 4.2 m and conformed the shrine onto the new ground, which put
; it 0.74 m under the declared surface with its map pin under the water too. The shoreline along
; this stretch runs at about z = 12 and drops fast: +0.53 at z = 11.5, -0.69 at z = 13.
[node name="ShrineElyndra" type="Node3D" parent="Nav"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -13, 0, 11.5)
script = ExtResource("2_entity")

