; Its own PersistentId — LairSpawnComponent.SaveId derives from it, so sharing one with the Wild
; dragon's nest would make killing either mark both defeated.
[node name="Nest" parent="." index="1"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 0, 6)
DisplayName = "Ash Roost"
PersistentId = "lair.frostfang_ash_roost"

; DefeatFlagId so the Ancient can tell the deed is already done. quest.ancient.kin asks the player to
; kill this dragon, and this lair is the only thing in the game that spawns one — so a player who came
; east before north would otherwise take a quest that can never complete.
[node name="Lair" parent="Nest" index="0"]
TemplateId = "enemy.ash_dragon"
DefeatFlagId = "flag.ash_dragon_defeated"

