<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Embervale</RootNamespace>
    <AssemblyName>Embervale</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      ⚠️ CS0618 (obsolete API) IS SUPPRESSED ASSEMBLY-WIDE, AND IT COSTS SOMETHING. The Godot-MCP
      addon under addons/godot_mcp/ calls three EditorPlugin dock methods Godot 4.7 deprecated, and
      Godot compiles every .cs in the project into ONE assembly — csc has no per-file suppression, so
      there is no way to silence the addon without silencing src/ too. The alternatives were worse: a
      `#pragma` in a vendored file is clobbered by the next addon update (silently), and living with
      three warnings retires this repo's 0-warning standard, which is reported every session and is
      how a real defect gets noticed.

      What it costs: an obsolete-API call in OUR code is now invisible at build time. If the addon is
      ever removed or fixed upstream, DELETE THIS LINE and check the build is still clean.
    -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <!--
    Safety guard: the Godot .NET SDK globs every *.cs file recursively under the
    project directory. A stray nested copy of the source tree (e.g. an accidental
    Embervale/ subfolder) would compile every class twice, producing hundreds of
    duplicate-definition errors. Exclude any such nested copies from compilation.
  -->
  <ItemGroup>
    <Compile Remove="Embervale/**/*.cs" />
    <!--
      The headless xUnit project lives under tests/ and is a separate
      Microsoft.NET.Sdk project. Exclude it from this project's recursive *.cs glob
      so the game assembly never compiles the test sources (which pull in xUnit).
    -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <!--
    Godot-MCP (IvanMurzak/Godot-MCP v0.20.1), added by `godot-cli install-plugin`. The addon is C#
    under addons/godot_mcp/ and Godot compiles EVERY .cs in the project into this one assembly, so
    its NuGet dependencies have to be declared here or the addon does not build.

    ⚠️ THE ADDON IS THIRD-PARTY CODE IN OUR ASSEMBLY. A broken release breaks the game build, not
    just the tooling. If it ever does, back it out with the three edits this comment sits beside plus
    `rm -r addons/godot_mcp` — nothing in src/ references it.
  -->
  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.4.0" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="7.5.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json" LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>
</Project>
