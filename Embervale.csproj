<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Embervale</RootNamespace>
    <AssemblyName>Embervale</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    ============================================================================
    RUNTIME AND CODE GENERATION (2026-10 performance pass)
    ============================================================================
    THE DEBUG CONFIGURATION IS THE ONE THE GAME IS PLAYED IN. The editor binary (F5, the MCP
    run, every probe and headless gate launched on the project path) always loads
    .godot/mono/temp/bin/Debug/Embervale.dll, and Godot.NET.Sdk's Sdk.props sets
    Optimize=false for Debug. An assembly compiled that way carries
    DebuggableAttribute(DisableOptimizations), which makes the JIT emit unoptimized code for
    every method in it and never tier it up: no inlining, no enregistration, for all of
    gameplay. Only the exported ExportRelease build was optimized.

    EmbervaleOptimizeDebug = true (default) compiles Debug with optimizations, the same code
    generation the shipping build gets. Symbols, DEBUG/TOOLS defines and every #if are
    unchanged. Stepping through locals under a debugger is the one thing it costs; build with
    `-p:EmbervaleOptimizeDebug=false` for a session that needs it.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(EmbervaleOptimizeDebug)' != 'false'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    These two are written into Embervale.runtimeconfig.json (configProperties). They are
    HONOURED ONLY BY AN EXPORTED GAME, which starts the runtime from that file; the editor
    binary starts it from the engine's own GodotSharp/Api/*/GodotPlugins.runtimeconfig.json
    and ignores the project's. Both equal the .NET 8 defaults, so this pins the configuration
    the game is tuned for rather than changing it: background gen-2 collections and dynamic
    PGO. The GC stays the workstation one by leaving ServerGarbageCollector unset (server GC
    takes a heap and a thread per core, wrong for a laptop sharing RAM with its GPU; the SDK
    writes nothing for an explicit false). ApplicationRoot logs what the runtime actually
    reports at boot.

    Deliberately absent: InvariantGlobalization (player-facing numbers and save-slot dates are
    formatted with the machine culture, and Windows ships no ICU payload to drop) and
    PublishReadyToRun (needs the crossgen2 pack at export and an export run to verify).
  -->
  <PropertyGroup>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    ============================================================================
    THE TOOLING GATE (2026-09-03 infrastructure overhaul)
    ============================================================================
    Godot compiles EVERY *.cs under the project directory into ONE assembly, so
    a literal Embervale.Game / Embervale.EditorTools / Embervale.GodotMcpIntegration
    project split is impossible for anything a .tscn or .tres attaches a script to.
    The achievable separation is per build CONFIGURATION, which is what this is.

    EmbervaleTooling = true   -> editor/dev build: the Godot-MCP addon and the
                                screenshot harnesses compile, exactly as before.
    EmbervaleTooling = false  -> shipping build: neither does, the addon's two
                                NuGet packages are not referenced, and the
                                assembly-wide CS0618 suppression they require is
                                not applied.

    It is FALSE for ExportRelease automatically. Override on any build with
    `dotnet build -p:EmbervaleTooling=false` to see what the shipping assembly
    compiles to without exporting.

    The tracked Windows Desktop preset produces build/windows/Embervale.exe and
    its PCK. The ExportRelease assembly check and packaged story smoke verify
    the shipping build; current evidence is recorded in docs/NOW.md.
  -->
  <PropertyGroup>
    <EmbervaleTooling Condition="'$(EmbervaleTooling)' == '' And '$(Configuration)' == 'ExportRelease'">false</EmbervaleTooling>
    <EmbervaleTooling Condition="'$(EmbervaleTooling)' == ''">true</EmbervaleTooling>
  </PropertyGroup>

  <!--
    CS0618 (obsolete API) is suppressed ONLY while the third-party Godot-MCP addon
    is being compiled: it calls three EditorPlugin dock methods Godot 4.7 deprecated,
    and csc has no per-file suppression. A #pragma in a vendored file is clobbered
    silently by the next addon update, so the suppression lives here beside the
    condition that scopes it. In a shipping build the addon is gone and so is this,
    which means an obsolete-API call in OUR code is a build ERROR there.
  -->
  <PropertyGroup Condition="'$(EmbervaleTooling)' == 'true'">
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <DefineConstants>$(DefineConstants);EMBERVALE_TOOLING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Safety guard: the Godot .NET SDK globs every *.cs file recursively under the
      project directory. A stray nested copy of the source tree (e.g. an accidental
      Embervale/ subfolder) would compile every class twice, producing hundreds of
      duplicate-definition errors. Exclude any such nested copies from compilation.
    -->
    <Compile Remove="Embervale/**/*.cs" />
    <!--
      The headless xUnit project lives under tests/ and is a separate
      Microsoft.NET.Sdk project. Exclude it from this project's recursive *.cs glob
      so the game assembly never compiles the test sources (which pull in xUnit).
    -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!--
    Godot-MCP (IvanMurzak/Godot-MCP v0.20.1), added by `godot-cli install-plugin`.
    Third-party C# in our assembly: a broken release breaks the GAME build, not just
    the tooling. Back it out with `rm -r addons/godot_mcp` plus this whole ItemGroup —
    nothing in src/ references it.
  -->
  <ItemGroup Condition="'$(EmbervaleTooling)' == 'true'">
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.4.0" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="7.5.2" />
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json" LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>

  <!--
    Development-only source, excluded from a shipping build. Two families:
      * the vendored Godot-MCP editor addon (third-party, editor-bound);
      * the screenshot/repro harnesses under src/Debugging, which exist to drive
        the `panelshots` capture flag and friends and have no gameplay caller.
    ContentValidator, Invariant, DevConsole, DevCommands, WorldIntegrityChecker and
    ProfilerOverlay deliberately STAY in the shipping assembly: the `validate` headless mode runs
    from the game executable and is a required CI gate, and the dev overlays are
    already gated at runtime by BuildProfile.ShowDeveloperTools.
  -->
  <ItemGroup Condition="'$(EmbervaleTooling)' != 'true'">
    <Compile Remove="addons/**/*.cs" />
    <Compile Remove="src/Debugging/*Shots.cs" />
    <Compile Remove="src/Debugging/ShotHarness.cs" />
    <Compile Remove="src/Debugging/ReproHarness.cs" />
    <Compile Remove="src/Debugging/VfxPerfScenario.cs" />
    <Compile Remove="src/Debugging/Magic*ProbeDriver.cs" />
    <Compile Remove="src/Debugging/*AuditProbeDriver.cs" />
    <Compile Remove="src/Debugging/SaveAuditProbe.cs" />
    <Compile Remove="src/Magic/MagicStatusProbeSeam.cs" />
    <Compile Remove="src/Bootstrap/BuildFreshness.cs" />
    <Compile Remove="src/Bootstrap/SessionEntryRules.cs" />
    <Compile Remove="src/Bootstrap/Arena*.cs" />
  </ItemGroup>
</Project>
