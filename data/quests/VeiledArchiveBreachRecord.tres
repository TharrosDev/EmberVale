[ext_resource type="Script" path="res://src/Quests/QuestItemReward.cs" id="3_reward"]

; Phase 42H - the truth-custody finale. Cross-realm recovery on three mapped places (Ember Crown,
; Ashen Wilds, Sunspire), then preserve / share / seal at Ysolde's hand-in, recorded as
; flag.veiled_archive.custody_<verdict>. Act III handoff: the main story reads none of these flags
; and none of this text anticipates the Archivist's reading, so every outcome leaves quest.main.truth
; exactly as it was.

[sub_resource type="Resource" id="Obj_stones"]
script = ExtResource("2_obj")
Type = 2
TargetId = "location.ember_crown.ashen_breach"
RequiredCount = 1
Description = "quest.veiled_archive.breach_record.obj_stones"

[sub_resource type="Resource" id="Obj_hearth"]
script = ExtResource("2_obj")
Type = 2
TargetId = "location.ashen.last_hearth"
RequiredCount = 1
