[sub_resource type="Resource" id="Obj_library"]
script = ExtResource("2_obj")
Type = 2
TargetId = "location.sunspire.library"
RequiredCount = 1
Description = "quest.veiled_archive.breach_record.obj_library"

[sub_resource type="Resource" id="Reward_item"]
script = ExtResource("3_reward")
ItemId = "item.ring.custodians_seal"
Quantity = 1

[resource]
script = ExtResource("1_quest")
Id = "quest.veiled_archive.breach_record"
Title = "quest.veiled_archive.breach_record.title"
Summary = "quest.veiled_archive.breach_record.summary"
