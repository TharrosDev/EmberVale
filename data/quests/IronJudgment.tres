[gd_resource type="Resource" script_class="QuestResource" format=3]

[ext_resource type="Script" path="res://src/Quests/QuestResource.cs" id="1_quest"]
[ext_resource type="Script" path="res://src/Quests/ObjectiveResource.cs" id="2_obj"]

; Phase 42I — the third rung, and the one the sub-phase is named for: a spare/kill resolution on a
; single named mark, Corran Vess, rather than a kill count. No PrerequisiteQuestId chain problem here
; — it IS the end of the chain (PrerequisiteQuestId = quest.iron.escort) — so "varied paid work" reads
; left to right: a bounty, then an escort, then a judgment, and only then is there anything to
; advance.
;
; ⚠️ THE TWO OBJECTIVES ARE THE WHOLE BRANCH, AND NEITHER NEEDS THE OTHER'S FLAG TO START. Obj_kill is
; live from the moment the quest starts (ForbiddenFlagId only shuts it once Obj_spare's flag is set),
; which is what lets "target dead early" work: nothing about killing Corran requires ever opening his
; dialogue. Obj_spare is the mirror, gated in (RequiredFlagId) rather than out, so it is the ordinary
; "a gated-off objective is INERT, not incomplete" case (ObjectiveResource) rather than a new shape.
;
; ⚠️ AllowsOneShotTarget = true, AND THE PROMISE IT MAKES IS KEPT BY dialogue.syndicate_fixer's OWN
; offer node (Condition = MissingFlag / HasFlag on flag.iron.judgment_target_dead, the Kill
; objective's own ForbiddenFlagId... no - its DefeatFlagId, set by the LairSpawnComponent marker in
; scenes/regions/ember_crown/hollowreach.tscn): a player who kills Corran before ever hearing of the
; contract is offered "that account is already closed" instead of a quest that can never complete.
;
; ⚠️ NEITHER PATH PAYS DIFFERENTLY, for WhatThePostTook's reason (41D): the ending is the flag
; (flag.iron.judgment_target_dead vs flag.iron.judgment_spared), which 42J's finale has to read, and a
; second place rewards live is invariant 5 waiting to happen. FactionRewardId is deliberately EMPTY
; here - the kill path already pays its own public-standing cost automatically, through
; ReputationComponent reacting to Corran's own FactionComponent (faction.villagers), and a flat quest
; reward on top would either double-charge the kill or wrongly charge the spare.

[sub_resource type="Resource" id="Obj_kill"]
script = ExtResource("2_obj")
Type = 0
TargetId = "enemy.iron_mark"
RequiredCount = 1
Description = "quest.iron.judgment.obj_kill"
LocationId = "location.hollowreach.mark"
ForbiddenFlagId = "flag.iron.judgment_spared"

[sub_resource type="Resource" id="Obj_spare"]
script = ExtResource("2_obj")
Type = 3
TargetId = "dialogue.iron_mark"
RequiredCount = 1
Description = "quest.iron.judgment.obj_spare"
RequiredFlagId = "flag.iron.judgment_spared"

[resource]
script = ExtResource("1_quest")
Id = "quest.iron.judgment"
Title = "quest.iron.judgment.title"
Summary = "quest.iron.judgment.summary"
Objectives = Array[Resource]([SubResource("Obj_kill"), SubResource("Obj_spare")])
XpReward = 100
GoldReward = 55
GoldItemId = "item.currency.gold"
RewardItems = []
FactionRewardId = ""
FactionRewardAmount = 0
PrerequisiteQuestId = "quest.iron.escort"
IsMainQuest = false
AllowsOneShotTarget = true
