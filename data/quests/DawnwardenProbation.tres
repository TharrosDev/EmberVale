RequiredCount = 1
Description = "quest.dawnwardens.probation.obj_rescue"
RequiredFlagId = "flag.dawnwardens.probation_rescue"

[sub_resource type="Resource" id="Obj_expedient"]
script = ExtResource("2_obj")
Type = 2
TargetId = "location.crossway.watch"
RequiredCount = 1
Description = "quest.dawnwardens.probation.obj_expedient"
RequiredFlagId = "flag.dawnwardens.probation_expedient"

