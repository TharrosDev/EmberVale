RequiredFlagId = "flag.ancient.taught"
LocationId = "location.embermarket.annexe"

[sub_resource type="Resource" id="Obj_report_defeated"]
script = ExtResource("2_obj")
Type = 3
TargetId = "dialogue.archive_keeper"
RequiredCount = 1
Description = "quest.veiled_archive.ancient_lead.obj_report_defeated"
RequiredFlagId = "flag.ancient_dragon_defeated"
LocationId = "location.embermarket.annexe"

[resource]
