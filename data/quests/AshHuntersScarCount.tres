[ext_resource type="Script" path="res://src/Quests/ObjectiveResource.cs" id="2_obj"]

; Phase 42F - rank two of the Ash Hunters. Started by dialogue.hunter_master (accept gated on
; GuildRankAtLeast faction.ash_hunters:1); rank two is SetFlag on the hand-in. The station is the
; atlas's reserved Ash Hunters hook (location.ashen.station); the maws are encounter.wilds_maw_pack,
; which respawns, so the Kill objective can always complete. The Talk objective completes on any end
; of Hask's conversation - he gained a QuestActive line for it, but any report counts.

[sub_resource type="Resource" id="Obj_station"]
script = ExtResource("2_obj")
Type = 2
TargetId = "location.ashen.station"
RequiredCount = 1
Description = "quest.ash_hunters.scar_count.obj_station"

