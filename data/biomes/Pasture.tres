; Grazed and walled ground around a settlement - the market's fields, Ashfall's holding. The one
; Ember Crown biome whose Ground is living grass rather than soil, which is what makes the inhabited
; belt read as greener than the wilds without a single extra prop.
[resource]
script = ExtResource("1_biome")
Id = "biome.pasture"
Ground = ExtResource("2_grass")
Sparse = ExtResource("3_deadgrass")
Rock = ExtResource("4_stone")
Cap = ExtResource("4_stone")
Road = ExtResource("5_roadearth")
Shore = ExtResource("6_wetshore")
SlopeBand = Vector2(0.36, 0.85)
HeightBand = Vector2(14, 30)
CapSlopeShed = 0.3
SparseCoverage = 0.45
MacroScale = 80.0
MacroStrength = 0.18
StrataScale = 3.0
StrataStrength = 0.36
