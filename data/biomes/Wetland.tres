; HOLLOWREACH, THE FEN AND TARN'S SHORE. Marsh ground over churned mud, and - the part that matters -
; a real ShoreBand: everything under y = 1.0 goes to the dark, half-specular wet layer and fades out
; 1.8 m above it. That is the waterline drawn by the TERRAIN rather than by the edge of a water box,
; which is what lets the water planes be drawn generously larger than the wet ground and bury their
; own borders in the banks.
[resource]
script = ExtResource("1_biome")
Id = "biome.wetland"
Ground = ExtResource("2_marsh")
Sparse = ExtResource("3_mud")
Rock = ExtResource("4_stone")
Cap = ExtResource("5_deadgrass")
Road = ExtResource("6_roadearth")
Shore = ExtResource("7_wetshore")
SlopeBand = Vector2(0.38, 0.9)
HeightBand = Vector2(6, 16)
CapSlopeShed = 0.25
SparseCoverage = 0.5
MacroScale = 60.0
MacroStrength = 0.24
ShoreLevel = 1.0
ShoreBand = 1.8
StrataScale = 2.4
StrataStrength = 0.3
