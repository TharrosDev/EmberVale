; FROSTFANG REACH'S DEFAULT, AND THE REASON IT LOOKS LIKE A DIFFERENT COUNTRY. Ground is STONE, not
; soil - the mountain is bedrock with turf clinging to it, the inverse of the Ember Crown. Cap is
; snow with a high CapSlopeShed, so the white lies on shelves and benches and slides off every face
; steeper than a walk: that shed is the single term that makes the massif read as alpine rather than
; as a brown region painted white.
[resource]
script = ExtResource("1_biome")
Id = "biome.alpine"
Ground = ExtResource("2_stone")
Sparse = ExtResource("3_alpineturf")
Rock = ExtResource("4_cliffrock")
Cap = ExtResource("5_snow")
Road = ExtResource("6_roadstone")
Shore = ExtResource("7_ice")
SlopeBand = Vector2(0.3, 0.75)
HeightBand = Vector2(20, 40)
CapSlopeShed = 0.82
SparseCoverage = 0.4
MacroScale = 120.0
MacroStrength = 0.16
StrataScale = 4.2
StrataStrength = 0.52
