; Under canopy: damp soil going to moss, rock close to the surface. Used where the scatter is dense
; enough that the ground is read in patches between trunks rather than as open country.
[resource]
script = ExtResource("1_biome")
Id = "biome.woodland"
Ground = ExtResource("2_soil")
Sparse = ExtResource("3_moss")
Rock = ExtResource("4_cliffrock")
