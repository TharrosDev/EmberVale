Road = ExtResource("6_roadearth")
Shore = ExtResource("7_wetshore")
SlopeBand = Vector2(0.32, 0.78)
HeightBand = Vector2(13, 29)
CapSlopeShed = 0.4
SparseCoverage = 0.58
MacroScale = 70.0
MacroStrength = 0.22
StrataScale = 2.6
