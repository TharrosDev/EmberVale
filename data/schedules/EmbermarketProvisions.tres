[gd_resource type="Resource" script_class="ScheduleResource" format=3 uid="uid://uowild10xkbj"]

[ext_resource type="Script" path="res://src/Npc/ScheduleResource.cs" id="1_sched"]
[ext_resource type="Script" path="res://src/Npc/ScheduleEntry.cs" id="2_entry"]

; Corvin the provisioner (Phase 38L).
;
; ⚠️ DESTINATIONS ARE CELL-LOCAL. Origin carries the Embermarket's Center (0, 0, 46), so these read
; straight out of embermarket.tscn (re-read from the the 2026-08-28 layout rebuild Coilyard rebuild — the stall rows are gone) without anyone doing the arithmetic by hand thirty times. A raw
; world destination copied from a cell .tscn lands a cell's width away and nothing reports it.
;
; ⚠️ These hours track shop.embermarket.provisions (5:00-19:00) and are kept in step BY HAND. A ScheduleId lives
; in a .tscn, which ContentValidator cannot scan, so if the shop's hours move, move these with them or
; the player finds Corvin standing at a stall that refuses to sell.
;
; Both destinations are on the market floor. ScheduleComponent walks a straight line with no navmesh
; pathing, so the packing-up spot is a couple of metres behind the stall, not the tavern in the square.

[sub_resource type="Resource" id="e_setup"]
script = ExtResource("2_entry")
StartHour = 4
Activity = "Setting out the trays"
Destination = Vector3(-3.2, 0, -12.8)

[sub_resource type="Resource" id="e_trade"]
script = ExtResource("2_entry")
StartHour = 5
Activity = "Selling bread"
Destination = Vector3(-3.2, 0, -12.8)

[sub_resource type="Resource" id="e_close"]
script = ExtResource("2_entry")
StartHour = 19
Activity = "Shuttering the stall"
Destination = Vector3(-1.8, 0, -12.2)

[resource]
script = ExtResource("1_sched")
Id = "schedule.embermarket.provisions"
; ⚠️ Origin moved with the cell in the 2026-08-29 geography overhaul. Destinations below are
; CELL-LOCAL and did not change; only the cell's world Center did. Read the local point, never
; the old world number.
Origin = Vector3(0, 0, 85)
Entries = Array[Resource]([SubResource("e_setup"), SubResource("e_trade"), SubResource("e_close")])
