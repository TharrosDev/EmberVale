[ext_resource type="Script" path="res://src/Npc/ScheduleEntry.cs" id="2_entry"]

; Wenna Tarn, the curer (Phase 38N2).
;
; ⚠️ DESTINATIONS ARE CELL-LOCAL against Origin (-106, 0, -10), the Landing's Center (38L's
; ScheduleResource.Origin). A raw world destination copied out of a cell .tscn lands a cell's width
; away and nothing reports it.
;
; ⚠️ Hours track shop.tarn.curer (4:00-14:00) and are kept in step BY HAND — a ScheduleId lives in a
; .tscn, which ContentValidator cannot scan.
;
; She meets the boats at the jetty before dawn, works the racks through the morning, and is gone by
; mid-afternoon. ScheduleComponent walks a straight line with no pathing, so both points are on open
; shingle.
;
; ⚠️ "MEETING THE BOATS" WAS 2.70 m UNDER THE TARN (2026-08-31). Authored at (-6, 15) beside the dock
; complex when the water here was a decal on a flat floor; the 2026-08-29 overhaul cut the basin to
; 4.2 m and she walked into it every morning at 04:00. The point is now (-6, 11) — the shingle at the
; spit's south edge, where the shoreline actually runs. ⚠️ ALONG THIS STRETCH THE SHORE IS z = 12 AND
; THE BANK IS STEEP: +0.83 at z = 11, +0.07 at z = 12, -2.65 at z = 15. Author south of it and the
; next point is in the water again.

[sub_resource type="Resource" id="e_0"]
script = ExtResource("2_entry")
StartHour = 4
Activity = "Meeting the boats"
Destination = Vector3(-6, 0, 11)

[sub_resource type="Resource" id="e_1"]
script = ExtResource("2_entry")
StartHour = 6
Activity = "Working the curing racks"
Destination = Vector3(-9, 0, 7)

[sub_resource type="Resource" id="e_2"]
script = ExtResource("2_entry")
StartHour = 14
Activity = "Salting down what is left"
Destination = Vector3(-3.5, 0, 5.5)

[resource]
script = ExtResource("1_sched")
Id = "schedule.tarn.curer"
; ⚠️ Origin moved with the cell in the 2026-08-29 geography overhaul. Destinations below are
; CELL-LOCAL and did not change; only the cell's world Center did. Read the local point, never
; the old world number.
Origin = Vector3(-90, 0, -10)
Entries = Array[Resource]([SubResource("e_0"), SubResource("e_1"), SubResource("e_2")])
