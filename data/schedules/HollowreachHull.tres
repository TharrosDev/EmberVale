[ext_resource type="Script" path="res://src/Npc/ScheduleResource.cs" id="1_sched"]
[ext_resource type="Script" path="res://src/Npc/ScheduleEntry.cs" id="2_entry"]

; Sedge Marrow, the Wet Hull (Phase 38O).
;
; ⚠️ DESTINATIONS ARE CELL-LOCAL against Origin (-106, 0, 74), Hollowreach's Center (38L's
; ScheduleResource.Origin). A raw world destination copied out of a cell .tscn lands a cell's width
; away and nothing reports it.
;
; ⚠️ Hours track shop.hollowreach.hull (20:00-05:00) and are kept in step BY HAND — a ScheduleId lives
; in a .tscn, which ContentValidator cannot scan.
;
; She is the only merchant in the realm whose working day is the night, and the schedule is what makes
; that visible rather than merely true: at dusk she walks out to the pier head, works the dark hours by
; the north brazier, and is back inside the hull before the sun is up. A player who arrives at noon
; finds a shut hatch and a woman asleep, which is the shop's OpenHour said in a second language.
;
; ScheduleComponent walks a straight line with no pathing, so every point is on open board or shingle.
;
; ⚠️ ALL THREE POINTS WERE IN THE LAKE, AND A SCHEDULE IS WHY MOVING THE NPC IS NOT THE WHOLE FIX
; (2026-08-31). They were authored over the old flat floor at (-18, 4), (-14, 2) and (-17, 3); the
; 2026-08-29 overhaul carved that water into a real 4.5 m basin, so she spent twenty hours a day
; standing 2.8 to 4.6 m under a declared surface. Moving her .tscn transform alone would have walked
; her straight back in at 19:00. The points are now the dry equivalents of the same three beats:
; she sleeps at the spine's west end by her moored hull, walks out to the north jetty's landward
; head at dusk, and works the dark hours beside BrazierA. ⚠️ THE DRY GROUND IS +0.30 AGAINST A 0.05
; WATERLINE and it ends at x = -13 — a point west of that is back in the basin.

[sub_resource type="Resource" id="e_0"]
script = ExtResource("2_entry")
StartHour = 5
Activity = "Asleep aboard the hull"
Destination = Vector3(-12, 0, -0.5)

