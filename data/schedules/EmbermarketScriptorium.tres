[ext_resource type="Script" path="res://src/Npc/ScheduleResource.cs" id="1_sched"]
[ext_resource type="Script" path="res://src/Npc/ScheduleEntry.cs" id="2_entry"]

; Tam Quillfellow (Phase 38L).
;
; ⚠️ DESTINATIONS ARE CELL-LOCAL. Origin carries the Embermarket's Center (0, 0, 46), so these read
; straight out of embermarket.tscn without anyone doing the arithmetic by hand thirty times. A raw
; world destination copied from a cell .tscn lands a cell's width away and nothing reports it.
;
; ⚠️ These hours track shop.embermarket.scriptorium (9:00-17:00) and are kept in step BY HAND. A ScheduleId lives
; in a .tscn, which ContentValidator cannot scan, so if the shop's hours move, move these with them or
; the player finds Tam standing at a stall that refuses to sell.
;
; Both destinations are on the market floor. ScheduleComponent walks a straight line with no navmesh
; pathing, so the packing-up spot is a couple of metres behind the stall, not the tavern in the square.

[sub_resource type="Resource" id="e_setup"]
script = ExtResource("2_entry")
StartHour = 8
Activity = "Unchaining the stall"
Destination = Vector3(7.9, 0, -14)

[sub_resource type="Resource" id="e_trade"]
script = ExtResource("2_entry")
StartHour = 9
Activity = "Selling books"
Destination = Vector3(7.9, 0, -14)

[sub_resource type="Resource" id="e_close"]
script = ExtResource("2_entry")
StartHour = 17
Activity = "Chaining the stall"
Destination = Vector3(11.5, 0, -14)

[resource]
script = ExtResource("1_sched")
Id = "schedule.embermarket.scriptorium"
Origin = Vector3(0, 0, 46)
Entries = Array[Resource]([SubResource("e_setup"), SubResource("e_trade"), SubResource("e_close")])
