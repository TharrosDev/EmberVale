[ext_resource type="Script" path="res://src/Npc/ScheduleEntry.cs" id="2_entry"]

; Keeper Ysolde Marr (Phase 42B).
; ⚠️ Destinations are CELL-LOCAL: ScheduleComponent resolves them against the NPC's own
; streamed cell, so moving the cell moves the routine. A raw WORLD destination copied out of a .tscn lands a cell's width from
; where it was read, which is what broke nine routines in the 2026-08-29 overhaul.
; ⚠️ Nothing here enters the hub building: its shell is one box collider, so its footprint is a hole
; in the navmesh and a routine that ended inside it would be a leader who never arrives.

[sub_resource type="Resource" id="e_door"]
script = ExtResource("2_entry")
StartHour = 7
Activity = "In the Annexe door"
Destination = Vector3(-47.5, 0, -7.5)

[sub_resource type="Resource" id="e_market"]
script = ExtResource("2_entry")
StartHour = 12
Activity = "Across the market"
Destination = Vector3(-37, 0, -18)

