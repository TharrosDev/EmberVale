[ext_resource type="Script" path="res://src/Economy/ShopResource.cs" id="1_shop"]
[ext_resource type="Script" path="res://src/Economy/ShopStockEntry.cs" id="2_entry"]

; Odo Greenhand (Phase 38L). Mirela in the square is an apothecary who brews; Odo is a herbalist who
; gathers, and the difference is which end of the trade each specialises in - hers is `potion`, his is
; `herb` and `reagent`. Both accept all three, so a player never has to know which is which to sell.
;
; He carries the health potion Mirela also sells, and that is not redundancy: --validate rejects a
; Consumable stocked only by travelling shops, and a second resident shelf under a staple is cheap
; insurance against a future roster change making it one.
;
; Emberbloom is the reason the `herb` tag is worth specialising in at all - before it, there was one leaf.

[sub_resource type="Resource" id="Stock_bloom"]
script = ExtResource("2_entry")
ItemId = "item.material.emberbloom"
Quantity = 0

[sub_resource type="Resource" id="Stock_herb"]
