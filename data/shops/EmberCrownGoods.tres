[resource]
script = ExtResource("1_shop")
Id = "shop.ember_crown.goods"
NameKey = "shop.ember_crown.goods.name"
FactionId = "faction.villagers"
Stock = Array[Resource]([SubResource("Stock_potion"), SubResource("Stock_herb"), SubResource("Stock_ore"), SubResource("Stock_strips"), SubResource("Stock_scrap")])
RestockDays = 1
LeveledTable = ExtResource("3_leveled")
BuyMarkup = 1.5
SellFraction = 0.4
PurseGold = 250
