Quantity = 12

[sub_resource type="Resource" id="Stock_smoked"]
script = ExtResource("2_entry")
ItemId = "item.food.smoked_fish"
Quantity = 8

[resource]
script = ExtResource("1_shop")
Id = "shop.tarn.curer"
CellId = "ember_crown.tarn_landing"
NameKey = "shop.tarn.curer.name"
FactionId = "faction.villagers"
AcceptedTags = Array[String](["fish", "food"])
Specialties = Array[String](["fish"])
Stock = Array[Resource]([SubResource("Stock_fresh"), SubResource("Stock_eel"), SubResource("Stock_roe"), SubResource("Stock_oil"), SubResource("Stock_smoked")])
RestockDays = 1
BuyMarkup = 1.18
SellFraction = 0.28
PurseGold = 110
OpenHour = 4
CloseHour = 14
