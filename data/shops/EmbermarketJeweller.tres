[ext_resource type="Script" path="res://src/Economy/ShopInvestmentTier.cs" id="3_tier"]

; Nessa Brightcut (Phase 38L) - the dearest markup on the square (1.7) and the deepest purse of the ten
; residents (400g). Both are the same fact: gemstones are where a market keeps its money.
;
; The sapphire exists because `gem` had one member and it was the ruby half the loot tables already drop.
; A jeweller whose entire specialty is an item the player has six of is not a jeweller.
;
; She opens at 10:00, latest of the residents. A shop that keeps banker's hours is a characterisation, and
; it is also the one the player is most likely to find shut - which is exactly what the ShopClosed line in
; dialogue.jeweller is for.

[sub_resource type="Resource" id="Stock_sapphire"]
script = ExtResource("2_entry")
ItemId = "item.gem.sapphire"
Quantity = 2

[sub_resource type="Resource" id="Stock_ruby"]
script = ExtResource("2_entry")
ItemId = "item.gem.ruby"
Quantity = 1

[sub_resource type="Resource" id="Stock_ring"]
script = ExtResource("2_entry")
ItemId = "item.ring.iron"
Quantity = 1
RequiredInvestment = 1

[sub_resource type="Resource" id="Invest_share"]
script = ExtResource("3_tier")
Cost = 900
PurseBonus = 250

[sub_resource type="Resource" id="Invest_partner"]
script = ExtResource("3_tier")
Cost = 2000
PurseBonus = 500

[resource]
script = ExtResource("1_shop")
Id = "shop.embermarket.jeweller"
NameKey = "shop.embermarket.jeweller.name"
FactionId = "faction.villagers"
AcceptedTags = Array[String](["gem", "jewelry", "luxury"])
Specialties = Array[String](["gem", "jewelry"])
Stock = Array[Resource]([SubResource("Stock_sapphire"), SubResource("Stock_ruby"), SubResource("Stock_ring")])
RestockDays = 3
BuyMarkup = 1.7
SellFraction = 0.45
PurseGold = 400
InvestmentTiers = Array[Resource]([SubResource("Invest_share"), SubResource("Invest_partner")])
OpenHour = 10
CloseHour = 18
