FactionId = "faction.villagers"
AcceptedTags = Array[String](["food", "fuel", "textile"])
Specialties = Array[String](["food"])
Stock = Array[Resource]([SubResource("Stock_ration"), SubResource("Stock_pick")])
RestockDays = 2
BuyMarkup = 1.7
SellFraction = 0.62
PurseGold = 260
HaggleChance = 30
HaggleDelta = -3
OpenHour = 6
CloseHour = 20
