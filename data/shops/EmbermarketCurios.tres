[ext_resource type="Script" path="res://src/Economy/ShopStockEntry.cs" id="2_entry"]

; Quill the Curioseller (Phase 38L) - the second traveller, one day in three, and the only merchant in
; the game who specialises in `relic`. He keeps the latest hours on the square (11:00-21:00) because what
; he deals in is not the sort of thing anyone buys in daylight.
;
; ⚠️ VendorComponent rather than dialogue, for the same forced reason as Sera - see EmbermarketCaravan.tres
; for the long version. His ShopId is likewise unvalidated.
;
; ⚠️ No consumables, same rule.
;
; He is the market's outlet for what comes back from the wilds: he accepts trophies and gems he does not
; stock, which is what makes him worth catching after a run rather than before one. His rune shards are
; the only `arcane` goods in the realm that are neither a ring nor a mote.

[sub_resource type="Resource" id="Stock_shard"]
script = ExtResource("2_entry")
ItemId = "item.material.rune_shard"
Quantity = 2

