[ext_resource type="Script" path="res://src/Enemies/BossAddWaveResource.cs" id="3_wave"]

; The Hollow Queen's fight, modelled on data/bosses/IronKing.tres: 66% / 33% thresholds, add waves
; from the second phase, and a third phase that fights differently rather than only faster.
;
; Phase 1 — the caster. She holds her distance (ai.hollow_queen) and withers.
; Phase 2 — she commands the dead: two bone knights rise, and she learns to knit their bones.
; Phase 3 — she stops keeping her distance. ai.boss (closes and never kites), a frost nova at arm's
;           length, a siphon that feeds on you, and husks that keep coming, capped at three alive.
;           The answer changes from chasing a caster down to surviving one who has come to you.
[sub_resource type="Resource" id="Wave_knights"]
script = ExtResource("3_wave")
TemplateId = "enemy.bone_knight"
Count = 2
RepeatSeconds = 0.0
MaxAlive = 0
HealthMultiplier = 1.0

[sub_resource type="Resource" id="Wave_husks"]
script = ExtResource("3_wave")
TemplateId = "enemy.hollow_husk"
Count = 2
RepeatSeconds = 20.0
MaxAlive = 3
HealthMultiplier = 1.0

