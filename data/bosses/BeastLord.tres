; The Beast Lord's fight, modelled on data/bosses/IronKing.tres: three phases, add waves of existing
; beast archetypes, and a phase three that fights differently rather than only faster.
;
; Phase two calls his pack: two dire wolves, once. Phase three the scar answers him: ash maws keep
; coming out of the Wilds, capped at three alive. No enrage, like the King.

[sub_resource type="Resource" id="Wave_pack"]
script = ExtResource("3_wave")
TemplateId = "enemy.dire_wolf"
Count = 2
RepeatSeconds = 0.0
MaxAlive = 0
HealthMultiplier = 1.0

[sub_resource type="Resource" id="Wave_maws"]
script = ExtResource("3_wave")
TemplateId = "enemy.ash_maw"
Count = 2
RepeatSeconds = 20.0
MaxAlive = 3
HealthMultiplier = 1.0

