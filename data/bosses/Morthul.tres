[gd_resource type="Resource" script_class="BossResource" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/Enemies/BossResource.cs" id="1_boss"]
[ext_resource type="Script" path="res://src/Enemies/BossPhaseResource.cs" id="2_phase"]
[ext_resource type="Script" path="res://src/Enemies/BossAddWaveResource.cs" id="3_wave"]
[ext_resource type="Script" path="res://src/Combat/Actions/ActionDefinitionResource.cs" id="4_action"]

; Morthul, the Ash King (the finish run, Act IV) — the strongest fight in the game. Four phases,
; every one of them a different problem, and every spell and add archetype already exists.
;
;   phase 1  the god walks to you: rake and crush, Wither at range.
;   phase 2  at 75% he stops walking. ai.caster: he holds a band and burns you with Flame Lance and
;            Fireball while the first ashen wave (cinder thralls) comes up the dais.
;   phase 3  at 50% he closes again, faster, drinking life back with Ember Siphon, and his
;            cultists keep coming (capped at three alive, the Iron King's rule).
;   phase 4  at 25%: entropy. A new move set (a sweeping unmaking and a slam that ends things), no
;            safe blow in it, and Ash Maws from the void. A six-minute enrage forces this phase.
;
; No relic: nothing of Morthul is left to carry. The defeat conversation is dialogue.ash_throne —
; the throne choice, which the main line owns (this realm ships its placeholder).
[sub_resource type="Resource" id="Wave_thralls"]
script = ExtResource("3_wave")
TemplateId = "enemy.cinder_thrall"
Count = 3
RepeatSeconds = 0.0
MaxAlive = 0
HealthMultiplier = 1.2

