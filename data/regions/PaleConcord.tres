[resource]
script = ExtResource("1_region")
Id = "region.pale_concord"
DisplayName = "The Pale Concord"
Realm = 5

; The landing: a stone quay beside the still canal in the south. The door home stands behind it.
SpawnPoint = Vector3(-2090, 1.2, 600)
PortalPoint = Vector3(-2090, 0, 616)

; ⚠️ THE SECRECY GATE. RegionSetup gives the door INTO this realm this flag as its RequiredFlagId, so
; the Sunspire library's portal stays hidden and inert until HiddenRealmReveal sets it.
UnlockFlagId = "flag.pale_concord_revealed"
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_west_mere"), SubResource("Cell_palace"), SubResource("Cell_north_fields"), SubResource("Cell_west_canal"), SubResource("Cell_processional"), SubResource("Cell_east_orchard"), SubResource("Cell_west_fields"), SubResource("Cell_city"), SubResource("Cell_east_canal"), SubResource("Cell_southwest_fields"), SubResource("Cell_landing"), SubResource("Cell_south_fields")])
EnvironmentProfile = SubResource("Environment_pale")
GenerationProfile = ExtResource("13_generation")
PerformanceBudget = SubResource("Budget_pale")
Bounds = AABB(-2380, -60, -180, 640, 160, 840)
SafeZoneCenter = Vector3(-2020, 0, 268)
SafeZoneRadius = 45.0
WeavePotency = 0.35
DefaultWeatherId = "weather.clear"
DayPhaseBias = 2
; Sealed: only encounters naming this realm (the Queen's servants) roll here.
ScopedContentOnly = true
Neighbours = Array[String](["region.sunspire"])
