[resource]
script = ExtResource("1_region")
Id = "region.frostfang_reach"
DisplayName = "Frostfang Reach"
Realm = 1

; The arrival is the southern gap in the fells, three hundred and fifty metres of vale road south of
; the Clan Hold; the portal back to the Ember Crown stands at the gap behind the player.
SpawnPoint = Vector3(-60, 1.2, -1336)
PortalPoint = Vector3(-60, 0, -1316)

; ⚠️ FROSTFANG IS NOT QUEST-GATED (maintainer direction, 2026-08-28). UnlockFlagId held
; "flag.frostfang.passage_open" — written by quest.warband.heart — and RegionSetup fed it to the
; portal's RequiredFlagId, so the door was hidden until that quest closed. It is EMPTY, and the
; portal is visible and usable from the first minute. The Crossway toll below is a separate thing
; and still fails closed: removing the quest gate made the crossing a price, not a prerequisite.
UnlockFlagId = ""
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_aerie_west"), SubResource("Cell_ancient_aerie"), SubResource("Cell_aerie_ascent"), SubResource("Cell_stormfall"), SubResource("Cell_stormcrown"), SubResource("Cell_north_snowfield"), SubResource("Cell_high_traverse"), SubResource("Cell_glacier_head"), SubResource("Cell_ice_shelf"), SubResource("Cell_ash_approach"), SubResource("Cell_roost_heights"), SubResource("Cell_snow_saddle"), SubResource("Cell_glacier"), SubResource("Cell_east_crags"), SubResource("Cell_ash_rim"), SubResource("Cell_dragon_roost"), SubResource("Cell_vale_head"), SubResource("Cell_hold_pass"), SubResource("Cell_burnt_col"), SubResource("Cell_ash_roost"), SubResource("Cell_west_scree"), SubResource("Cell_roost_trail"), SubResource("Cell_clan_hold"), SubResource("Cell_ravenspur"), SubResource("Cell_eastern_marches"), SubResource("Cell_western_fells"), SubResource("Cell_hunting_grounds"), SubResource("Cell_stormbound_vale"), SubResource("Cell_stonewatch"), SubResource("Cell_frost_march_e"), SubResource("Cell_east_fells"), SubResource("Cell_south_fells_w"), SubResource("Cell_frost_march_w"), SubResource("Cell_vale_foot"), SubResource("Cell_south_fells_e"), SubResource("Cell_southeast_fells")])
EnvironmentProfile = SubResource("Environment_frostfang")
GenerationProfile = ExtResource("13_generation")
PerformanceBudget = SubResource("Budget_frostfang")

; The lattice is x -460..500, z -2320..-1300, disjoint from the Ember Crown (x -520..520, z -720..440).
Bounds = AABB(-480, -80, -2340, 1000, 220, 1060)
SafeZoneCenter = Vector3(-40, 0, -1680)
SafeZoneRadius = 40.0
WeavePotency = 0.5
DefaultWeatherId = "weather.clear"
DayPhaseBias = 2
Neighbours = Array[String](["region.ember_crown"])

; The Crossway toll, northbound (Phase 38M). The twin of the block in EmberCrown.tres — same gate,
; same road, same permit — because the toll is declared on the destination and a crossing has two.
TollGold = 25
TollPermitFlagId = "flag.crossway.permit"
TollPassFlagId = "flag.crossway.pass"
