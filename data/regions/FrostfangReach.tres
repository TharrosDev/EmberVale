[sub_resource type="Resource" id="Cell_clan_hold"]
script = ExtResource("2_cell")
Id = "frostfang_reach.clan_hold"
ScenePath = "res://scenes/regions/frostfang_reach/clan_hold.tscn"
Center = Vector3(100, 0, -20)
Presentation = SubResource("Presentation_clan_hold")

; Placed WEST of the hold rather than north of it, so its 90 m floor stops exactly where the clan
; hold's 60 m floor begins (x = 70) — abutting, not overlapping, so there is walkable ground the
; whole way and no co-planar floors fighting. North was the obvious choice and the wrong one: the
; glacier cell sits at z = -60 and its props would have ended up inside the roost's floor, which is
; the same mistake 34.5A had to undo when it moved the glacier the first time.
[sub_resource type="Resource" id="Cell_dragon_roost"]
script = ExtResource("2_cell")
Id = "frostfang_reach.dragon_roost"
ScenePath = "res://scenes/regions/frostfang_reach/dragon_roost.tscn"
Center = Vector3(25, 0, -20)
Presentation = SubResource("Presentation_dragon_roost")

; The Ash dragon's roost, mirroring the Wild one to the EAST. Its 100 m floor spans x ∈ [130, 230],
; butting the clan hold's floor at x = 130 the same way the wild roost butts it at 70 — walkable
; across, no overlap, no co-planar z-fighting. The hold sits between the two of them.
[sub_resource type="Resource" id="Cell_ash_roost"]
script = ExtResource("2_cell")
Id = "frostfang_reach.ash_roost"
ScenePath = "res://scenes/regions/frostfang_reach/ash_roost.tscn"
Center = Vector3(180, 0, -20)
Presentation = SubResource("Presentation_ash_roost")

; The Ancient's aerie (35F), NORTH of the Wild dragon's roost and butted against it: its 90 m floor
; is z ∈ [-155, -65] where the wild roost's ends at z = -65, so the two abut without overlapping.
; East-west it shares the wild roost's x ∈ [-20, 70], which keeps it clear of the hold, the ash
; roost and the glacier props at (100, -60).
[sub_resource type="Resource" id="Cell_ancient_aerie"]
script = ExtResource("2_cell")
Id = "frostfang_reach.ancient_aerie"
ScenePath = "res://scenes/regions/frostfang_reach/ancient_aerie.tscn"
Center = Vector3(25, 0, -110)
Presentation = SubResource("Presentation_aerie")

[sub_resource type="Resource" id="Cell_glacier"]
script = ExtResource("2_cell")
Id = "frostfang_reach.glacier"
ScenePath = "res://scenes/regions/frostfang_reach/glacier.tscn"
Center = Vector3(100, 0, -60)
Presentation = SubResource("Presentation_glacier")

[resource]
script = ExtResource("1_region")
Id = "region.frostfang_reach"
DisplayName = "Frostfang Reach"
Realm = 1
SpawnPoint = Vector3(100, 1.2, 0)
UnlockFlagId = "flag.frostfang.passage_open"
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_clan_hold"), SubResource("Cell_glacier"), SubResource("Cell_dragon_roost"), SubResource("Cell_ash_roost"), SubResource("Cell_ancient_aerie")])
EnvironmentProfile = SubResource("Environment_frostfang")
Bounds = AABB(-256, -16, -256, 512, 64, 512)
SafeZoneCenter = Vector3(100, 0, -20)
SafeZoneRadius = 30.0
WeavePotency = 0.5
DefaultWeatherId = "weather.clear"
DayPhaseBias = 2
Neighbours = Array[String](["region.ember_crown"])

; The Crossway toll, northbound (Phase 38M). The twin of the block in EmberCrown.tres — same gate, same
; road, same permit — because the toll is declared on the destination and a crossing has two of those.
; The two must stay in step; the validator checks that a tolled region names flags some Passage service
; actually grants, which is what catches one of them being edited alone.
TollGold = 25
TollPermitFlagId = "flag.crossway.permit"
TollPassFlagId = "flag.crossway.pass"
