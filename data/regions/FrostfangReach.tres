; ⚠️ GENERATED BY tools/gen_regions.py FROM tools/region_spec_frostfang.py. Edit the spec.
;
; ====================================================================================================
; FROSTFANG REACH AFTER THE 2026-09 WORLD REBUILD
; ====================================================================================================
;
; WHAT CHANGED. The Reach was 340 x 380 m and read as a boss-selection hub: the Clan Hold with a dragon
; lair a hundred and twenty metres either side of it and the aerie two cells north. It is now 960 x
; 1020 m in its own atlas band north of the Ember Crown. The road comes in from the south into the
; Stormbound Vale, passes the clan's Stonewatch waystation and reaches the hold on its bench under the
; mountain wall three hundred and fifty metres later. The dragons live in their own country: the Wild
; roost up a side valley over the roost ridge to the west, the Ash roost past the burnt col to the
; east where the snow turns to ash, and the Ancient's aerie against the northern wall nine hundred
; metres from the arrival, reached through Glacier Pass or by the hunters' ridge route.
;
; SCATTERED, NOT DENSE. The clan's presence outside the hold is traces, not buildings: the waystation,
; an abandoned hunting lodge, the broken Ravenspur watch, cairns on the roads. Twenty-seven of the
; thirty-six cells are empty high country, and that emptiness — distance, exposure, altitude — is the
; realm's identity. Do not fill it in.
;
; Stormcrown, the blasted spire in the north-east high passes, is reserved for the Storm Tyrant
; (Phase 44E / 47E): a track reaches its foot and nothing else exists there.

[sub_resource type="Resource" id="Environment_frostfang"]
script = ExtResource("3_environment")
Biome = ExtResource("20_biome_alpine")
SurfaceColor = Color(0.49, 0.55, 0.60, 1)
SecondaryColor = Color(0.70, 0.75, 0.78, 1)
DetailColor = Color(0.26, 0.31, 0.36, 1)
RoadColor = Color(0.33, 0.37, 0.42, 1)
BackdropColor = Color(0.25, 0.29, 0.34, 1)
Relief = 2.2
DetailScale = 3.5
BackdropCenter = Vector3(430, 0, -120)
BackdropRadius = 330.0
BackdropHeight = 128.0
BackdropCount = 28
TerrainSeed = 3800
SurfaceRoughness = 0.93
DetailRoughness = 0.84
RoadRoughness = 0.78
SlopeBlendStart = 0.22
SlopeBlendEnd = 0.58
HeightBlendStart = 10.0
HeightBlendEnd = 34.0

; ⚠️ THE LIGHT IS THE REGION, NOT JUST THE PALETTE. Every terrain colour here is cold and the Clan
; Hold still rendered as warm tan sand, because a neutral-grey bedrock under the Ember Crown's
; golden-hour sun IS tan. SunTint pulls the key toward ART_STYLE §2.1's "hard white-blue"; the sun
; is also weaker and the air much thicker, which is what puts the aerial depth into a shot of a
; massif and what makes the Reach feel like altitude rather than like a repainted lowland.
SunTint = Color(0.74, 0.82, 0.96, 1)
SunEnergyScale = 0.86
HazeColor = Color(0.72, 0.79, 0.87, 1)
HazeScale = 1.55


