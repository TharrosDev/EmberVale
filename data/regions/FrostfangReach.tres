[resource]
script = ExtResource("1_region")
Id = "region.frostfang_reach"
DisplayName = "Frostfang Reach"
Realm = 1

; ⚠️ THE ARRIVAL IS 110 METRES SOUTH OF THE CLAN HOLD NOW. It used to be (100, 1.2, 0), which is
; twenty metres from the moot ring — a region that began inside its own capital. The portal stands at
; SpawnPoint + (0, -1.2, -4) because Frostfang authors no PortalPoint, so both are in the southern
; march and the hold is a walk up a road.
SpawnPoint = Vector3(415, 1.2, 55)

; ⚠️ FROSTFANG IS NOT QUEST-GATED (maintainer direction, 2026-08-28). UnlockFlagId held
; "flag.frostfang.passage_open" — written by quest.warband.heart — and RegionSetup fed it to the
; portal's RequiredFlagId, so the door was hidden until that quest closed. It is EMPTY, and the
; portal is visible and usable from the first minute. The Crossway toll below is a separate thing
; and still fails closed: removing the quest gate made the crossing a price, not a prerequisite.
UnlockFlagId = ""
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_frost_march_w"), SubResource("Cell_frost_march_e"), SubResource("Cell_dragon_roost"), SubResource("Cell_clan_hold"), SubResource("Cell_ash_roost"), SubResource("Cell_north_snowfield"), SubResource("Cell_glacier"), SubResource("Cell_ash_approach"), SubResource("Cell_ancient_aerie"), SubResource("Cell_aerie_ascent")])
EnvironmentProfile = SubResource("Environment_frostfang")
PerformanceBudget = SubResource("Budget_frostfang")

; The lattice is x 260..600, z -300..70, disjoint from the Ember Crown's x -190..140. The Y range
; carries the aerie summit at +24 and the ash crater floor at -4.
Bounds = AABB(240, -80, -320, 380, 220, 440)
SafeZoneCenter = Vector3(430, 0, -55)
SafeZoneRadius = 30.0
WeavePotency = 0.5
DefaultWeatherId = "weather.clear"
DayPhaseBias = 2
Neighbours = Array[String](["region.ember_crown"])

; The Crossway toll, northbound (Phase 38M). The twin of the block in EmberCrown.tres — same gate,
; same road, same permit — because the toll is declared on the destination and a crossing has two.
TollGold = 25
TollPermitFlagId = "flag.crossway.permit"
TollPassFlagId = "flag.crossway.pass"
