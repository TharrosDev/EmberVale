; ⚠️ GENERATED BY tools/gen_regions.py FROM tools/region_spec_ashen.py. Edit the spec.
;
; THE ASHEN WILDS — the Cataclysm scar east of the Ashen Breach. Warped plateaus, deep ravines, a
; crater field, two pockets of corrupted forest and dead ash country between them. The road comes
; through the Breach into the scar, reaches Last Hearth (the survivors) a hundred and seventy metres
; later, climbs north-east past the Ash Hunters' field station, and ends on the Beast Lord's plateau
; under the northern wall. Twelve of sixteen cells carry nothing but the weather. Do not fill them in.

[sub_resource type="Resource" id="Environment_ashen"]
script = ExtResource("3_environment")
Biome = ExtResource("20_biome_ashwaste")
SurfaceColor = Color(0.26, 0.23, 0.21, 1)
SecondaryColor = Color(0.36, 0.32, 0.29, 1)
DetailColor = Color(0.13, 0.11, 0.10, 1)
RoadColor = Color(0.40, 0.35, 0.30, 1)
BackdropColor = Color(0.20, 0.17, 0.16, 1)
Relief = 1.8
DetailScale = 3.0
BackdropRadius = 330.0
BackdropHeight = 96.0
TerrainSeed = 4400
SurfaceRoughness = 0.95
DetailRoughness = 0.86
RoadRoughness = 0.80
SlopeBlendStart = 0.22
SlopeBlendEnd = 0.58
HeightBlendStart = 9.0
HeightBlendEnd = 30.0

; The air is ash. A low, rust-orange key through a thick grey-brown haze is what makes the Wilds
; read as the scar rather than as the Ember Crown's burnt frontier with the colour turned down.
SunTint = Color(0.96, 0.78, 0.62, 1)
SunEnergyScale = 0.78
HazeColor = Color(0.52, 0.47, 0.44, 1)
HazeScale = 1.9


