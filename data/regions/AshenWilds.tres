[resource]
script = ExtResource("1_region")
Id = "region.ashen_wilds"
DisplayName = "The Ashen Wilds"
Realm = 2

; The arrival is the scar's western mouth, where the road from the Ashen Breach comes out; the
; portal back to the Ember Crown stands on the road behind the player.
SpawnPoint = Vector3(950, 1.2, -300)
PortalPoint = Vector3(928, 0, -298)

; Earned (docs/playbook/finish.md): the Breach portal in the Ember Crown stays hidden and inert until
; the Iron King is dead. RegionSetup feeds this to that portal's RequiredFlagId.
UnlockFlagId = "flag.iron_king_defeated"
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_north_scar"), SubResource("Cell_ash_plateau"), SubResource("Cell_cinder_ravine"), SubResource("Cell_beast_lair"), SubResource("Cell_dead_wood"), SubResource("Cell_hunters_rise"), SubResource("Cell_crater_field"), SubResource("Cell_lair_approach"), SubResource("Cell_breach_scar"), SubResource("Cell_last_hearth"), SubResource("Cell_ashen_flats"), SubResource("Cell_east_rim"), SubResource("Cell_south_ravines"), SubResource("Cell_blight_wood"), SubResource("Cell_scorched_hollow"), SubResource("Cell_far_rim")])
EnvironmentProfile = SubResource("Environment_ashen")
GenerationProfile = ExtResource("13_generation")
PerformanceBudget = SubResource("Budget_ashen")
Bounds = AABB(880, -80, -660, 640, 200, 600)
SafeZoneCenter = Vector3(1095, 0, -275)
SafeZoneRadius = 36.0
WeavePotency = 0.4
DefaultWeatherId = "weather.fog"
DayPhaseBias = 3
Neighbours = Array[String](["region.ember_crown"])
