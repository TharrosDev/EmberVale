[resource]
script = ExtResource("1_region")
Id = "region.sunspire"
DisplayName = "The Sunspire Dominion"
Realm = 3

; The arrival is the caravan road's gap in the northern escarpment; the portal back to the Ember
; Crown's Southmarch Gate stands in the gap behind the player.
SpawnPoint = Vector3(60, 1.2, 936)
PortalPoint = Vector3(60, 0, 916)

; ⚠️ EARNED, NOT OPEN (docs/playbook/finish.md). The Southmarch Gate's portal into this realm hides
; until the Iron King falls; RegionSetup feeds this to the portal's RequiredFlagId. The return door
; reads the Ember Crown's UnlockFlagId, which is empty, so nobody is ever shut in here.
UnlockFlagId = "flag.iron_king_defeated"
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_north_dunes_w"), SubResource("Cell_caravan_gap"), SubResource("Cell_north_dunes_e"), SubResource("Cell_northeast_scarp"), SubResource("Cell_west_mesa"), SubResource("Cell_salt_basin"), SubResource("Cell_caravan_road"), SubResource("Cell_east_mesa"), SubResource("Cell_belt_west"), SubResource("Cell_wells"), SubResource("Cell_belt_east"), SubResource("Cell_belt_far_east"), SubResource("Cell_library"), SubResource("Cell_sand_sea"), SubResource("Cell_red_flats"), SubResource("Cell_east_waste"), SubResource("Cell_south_dunes_w"), SubResource("Cell_pilgrim_track"), SubResource("Cell_temple"), SubResource("Cell_south_waste")])
EnvironmentProfile = SubResource("Environment_sunspire")
GenerationProfile = ExtResource("13_generation")
PerformanceBudget = SubResource("Budget_sunspire")

; The lattice is x -380..400, z 900..1790, inside the atlas band and disjoint from every other realm.
Bounds = AABB(-400, -80, 880, 820, 220, 930)
SafeZoneCenter = Vector3(10, 0, 1290)
SafeZoneRadius = 45.0
WeavePotency = 0.8
DefaultWeatherId = "weather.clear"
DayPhaseBias = 2
Neighbours = Array[String](["region.ember_crown"])
