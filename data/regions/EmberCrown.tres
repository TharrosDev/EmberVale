[resource]
script = ExtResource("1_region")
Id = "region.ember_crown"
DisplayName = "The Ember Crown"
Realm = 0
SpawnPoint = Vector3(35, 1.2, -15)

; ⚠️ THE PORTAL MOVED WITH THE CROSSWAY, NOT WITH THE PLAYER. The gate cell went from (0, 0, -66) to
; (0, 0, -95) when the lattice grew, so the portal that stood at world z = -72 — cell-local z = -6,
; the gap between the two palisades — is world z = -101 now. Read the local offset, never the old
; world number: that is the 37C placement bug and it is completely silent.
PortalPoint = Vector3(-150, 0, -652)
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_range_west"), SubResource("Cell_crown_pass"), SubResource("Cell_range_mid"), SubResource("Cell_range_east"), SubResource("Cell_emberspire"), SubResource("Cell_pass_foot_west"), SubResource("Cell_crossway_post"), SubResource("Cell_frontier_waste"), SubResource("Cell_ashen_reach"), SubResource("Cell_arena"), SubResource("Cell_range_foot_east"), SubResource("Cell_wildwood_west"), SubResource("Cell_wilds_north"), SubResource("Cell_emberwash_head"), SubResource("Cell_heath_south"), SubResource("Cell_east_uplands"), SubResource("Cell_western_ridge"), SubResource("Cell_wildwood_edge"), SubResource("Cell_north_moor"), SubResource("Cell_crown_fields_north"), SubResource("Cell_ashen_breach"), SubResource("Cell_wilds_west"), SubResource("Cell_emberwash_valley"), SubResource("Cell_kings_approach"), SubResource("Cell_citadel"), SubResource("Cell_mine_road"), SubResource("Cell_emberdeep_mine"), SubResource("Cell_tarn_north"), SubResource("Cell_tarn_road"), SubResource("Cell_bridgeward"), SubResource("Cell_town_hub"), SubResource("Cell_east_gate"), SubResource("Cell_emberdeep_slopes"), SubResource("Cell_tarn_west"), SubResource("Cell_tarn_landing"), SubResource("Cell_lakeshore_east"), SubResource("Cell_embermarket"), SubResource("Cell_south_fields"), SubResource("Cell_ashfall_lane"), SubResource("Cell_eastern_downs"), SubResource("Cell_outflow"), SubResource("Cell_reach_road"), SubResource("Cell_west_downs"), SubResource("Cell_caravan_road"), SubResource("Cell_ashfall_homestead"), SubResource("Cell_ash_flats"), SubResource("Cell_fen_edge"), SubResource("Cell_hollowreach"), SubResource("Cell_southern_fens"), SubResource("Cell_south_gate"), SubResource("Cell_border_hills"), SubResource("Cell_border_east")])
EnvironmentProfile = SubResource("Environment_ember_crown")
GenerationProfile = ExtResource("13_generation")
PerformanceBudget = SubResource("Budget_ember_crown")

; The lattice is x -190..140, z -310..130. Bounds are that plus a margin, and the Y range is real
; now: the Emberdeep pit floor is 6 m down and the frontier ridges are 25 m up.
Bounds = AABB(-540, -80, -740, 1080, 200, 1200)
SafeZoneCenter = Vector3(20, 0, -40)
SafeZoneRadius = 120.0
WeavePotency = 1.0
DefaultWeatherId = "weather.cloudy"
DayPhaseBias = 2
Neighbours = Array[String](["region.frostfang_reach", "region.ashen_wilds", "region.sunspire"])

; One door per neighbour (the Ashen Wilds and Sunspire, 2026-09). Frostfang's stays at the Crown Pass
; (PortalPoint); the Wilds' stands at the end of the burnt track in the Ashen Breach and Sunspire's in
; the Southmarch Gate, and a traveller coming back through either is put down beside it.
NeighbourPortalPoints = Array[Vector3]([Vector3(0, 0, 0), Vector3(492, 0, -282), Vector3(72, 0, 402)])
NeighbourArrivalPoints = Array[Vector3]([Vector3(0, 0, 0), Vector3(484, 1.2, -283), Vector3(72, 1.2, 394)])

; The Crossway toll (Phase 38M). Authored on BOTH regions rather than on one, because there is one
; gate on one road and the wardens do not care which way a cart is pointing. 25 gold sits under
; TravelFee.CrossRegionFee (40) on purpose: walking must stay the cheap way across, or the toll is a
; tax on the only option and the map screen quietly becomes the sensible one.
TollGold = 25
TollPermitFlagId = "flag.crossway.permit"
TollPassFlagId = "flag.crossway.pass"
; The Crossway wardens stand on the Frostfang road only; the Ashen Breach is not tolled.
TollFromRegionIds = Array[String](["region.frostfang_reach"])
