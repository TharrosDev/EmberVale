[resource]
script = ExtResource("1_region")
Id = "region.celestial"
DisplayName = "The Celestial Realm"
Realm = 4

; The arrival is the landing the Sunspire library's story gate lets out on. The return portal stands
; on the same landing, a few metres behind the player.
; ⚠️ TEMPORARY: it returns to the Ember Crown, because region.sunspire does not exist on the branch
; this realm was built on and --validate fails an unknown neighbour. When Sunspire lands, change the
; one id below to "region.sunspire" (the portal takes the player to that region's SpawnPoint).
SpawnPoint = Vector3(2632, 1.2, -1708)
PortalPoint = Vector3(2632, 0, -1697)
; ⚠️ UnlockFlagId IS EMPTY UNTIL THE MAIN LINE SETS flag.celestial_gate_open. --validate fails a region
; that unlocks on a flag nothing sets, and the setter (the Veiled Archive reading) is the main line's.
; When it lands, set UnlockFlagId = "flag.celestial_gate_open" here: a neighbour portal into this
; region then hides until the flag is set (RegionSetup.RebuildPortals), with no code change.
UnlockFlagId = "flag.celestial_gate_open"
Cells = Array[ExtResource("2_cell")]([SubResource("Cell_shattered_rim"), SubResource("Cell_ash_throne"), SubResource("Cell_godfall"), SubResource("Cell_fallen_choir"), SubResource("Cell_knight_gate"), SubResource("Cell_sundered_stair"), SubResource("Cell_landing"), SubResource("Cell_broken_concourse"), SubResource("Cell_void_edge")])
EnvironmentProfile = SubResource("Environment_celestial")
GenerationProfile = ExtResource("13_generation")
PerformanceBudget = SubResource("Budget_celestial")

; The lattice is x 2480..3120, z -2340..-1660, inside its atlas band (x 2400..3200, z -2400..-1600).
Bounds = AABB(2460, -60, -2360, 680, 200, 720)
SafeZoneCenter = Vector3(2632, 0, -1712)
SafeZoneRadius = 22.0
WeavePotency = 0.3
DefaultWeatherId = "weather.fog"
DayPhaseBias = 3
; Sealed like the Pale Concord: only the assault encounters that name this realm roll here.
ScopedContentOnly = true
Neighbours = Array[String](["region.sunspire"])
