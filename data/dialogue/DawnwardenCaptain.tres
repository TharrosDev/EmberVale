[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Captain Aldric Fenn (faction.dawnwardens). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.dawnwardens:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_member"
Condition = 14
ConditionArg = "faction.dawnwardens:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_stranger"
Condition = 15
ConditionArg = "faction.dawnwardens"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_end"

; 42D — THE HUB'S HALF OF THE POST-FINALE VARIANT. Gated "faction.dawnwardens:3" the same way the
; Serjeant's ch_finale_state is (the guild's declared rank ceiling, reached only once
; quest.dawnwardens.finale grants it) and additive beside "member"'s existing plain farewell, per
; 42B's rule: a rank-gated line is a third branch, never a narrowing of the one already there.
[sub_resource type="Resource" id="ch_finale_state"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_finale_state"
Condition = 14
ConditionArg = "faction.dawnwardens:3"
Goto = "finale_state"

[sub_resource type="Resource" id="ch_finale_state_service"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_finale_state_service"
Condition = 5
ConditionArg = "flag.dawnwardens.finale_service"
Goto = "finale_state_service"

[sub_resource type="Resource" id="ch_finale_state_authority"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_captain.c_finale_state_authority"
Condition = 5
ConditionArg = "flag.dawnwardens.finale_authority"
Goto = "finale_state_authority"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.dawnwarden_captain.root"
Choices = Array[Resource]([SubResource("ch_member"), SubResource("ch_stranger"), SubResource("ch_mg_menu"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_member"]
script = ExtResource("2_node")
Id = "member"
Text = "dlg.dawnwarden_captain.member"
Choices = Array[Resource]([SubResource("ch_finale_state"), SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_stranger"]
script = ExtResource("2_node")
Id = "stranger"
Text = "dlg.dawnwarden_captain.stranger"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_finale_state"]
script = ExtResource("2_node")
Id = "finale_state"
Text = "dlg.dawnwarden_captain.finale_state"
Choices = Array[Resource]([SubResource("ch_finale_state_service"), SubResource("ch_finale_state_authority"), SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_finale_state_service"]
script = ExtResource("2_node")
Id = "finale_state_service"
Text = "dlg.dawnwarden_captain.finale_state_service"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_finale_state_authority"]
script = ExtResource("2_node")
Id = "finale_state_authority"
Text = "dlg.dawnwarden_captain.finale_state_authority"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

; Magic upgrade: this NPC teaches spellcraft (spell.teach.* strings, LearnSpell effect).
[sub_resource type="Resource" id="ch_mg_menu"]
script = ExtResource("3_choice")
Text = "spell.teach.ask_menu"
Goto = "mg_teach"

[sub_resource type="Resource" id="ch_mg_sunfall"]
script = ExtResource("3_choice")
Text = "spell.sunfall.ask"
Goto = "mg_taught"
Effect = 8
EffectArg = "spell.sunfall"

[sub_resource type="Resource" id="ch_mg_back"]
script = ExtResource("3_choice")
Text = "spell.teach.back"
Goto = "root"

[sub_resource type="Resource" id="ch_mg_thanks"]
script = ExtResource("3_choice")
Text = "spell.teach.thanks"
Goto = "root"

[sub_resource type="Resource" id="node_mg_teach"]
script = ExtResource("2_node")
Id = "mg_teach"
Text = "spell.teach.dawnwarden_captain"
Choices = Array[Resource]([SubResource("ch_mg_sunfall"), SubResource("ch_mg_back")])

[sub_resource type="Resource" id="node_mg_taught"]
script = ExtResource("2_node")
Id = "mg_taught"
Text = "spell.teach.dawnwarden_captain.taught"
Choices = Array[Resource]([SubResource("ch_mg_thanks")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.dawnwarden_captain"
SpeakerName = "dlg.dawnwarden_captain.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_member"), SubResource("node_stranger"), SubResource("node_finale_state"), SubResource("node_finale_state_service"), SubResource("node_finale_state_authority"), SubResource("node_mg_teach"), SubResource("node_mg_taught")])
