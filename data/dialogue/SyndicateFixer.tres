[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Dallow Grieve (faction.iron_syndicate). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.iron_syndicate:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_member"
Condition = 14
ConditionArg = "faction.iron_syndicate:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_stranger"
Condition = 15
ConditionArg = "faction.iron_syndicate"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

; ── 42I: three postings, GuildBoard's offer/active/thanks triple (41B) three times over. Each
; contract's own PrerequisiteQuestId already keeps only one "offer" true at a time — bounty first,
; then escort, then judgment — so what "rotates" here is which posting is current, and the
; already-closed ones stay readable as their own "thanks" line rather than vanishing.

[sub_resource type="Resource" id="ch_bounty_offer"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_bounty_offer"
Condition = 1
ConditionArg = "quest.iron.bounty"
Goto = "bounty_offer"

[sub_resource type="Resource" id="ch_bounty_active"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_bounty_active"
Condition = 2
ConditionArg = "quest.iron.bounty"
Goto = "bounty_active"

[sub_resource type="Resource" id="ch_bounty_thanks"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_bounty_thanks"
Condition = 3
ConditionArg = "quest.iron.bounty"
Goto = "bounty_thanks"

[sub_resource type="Resource" id="ch_bounty_accept"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_bounty_accept"
Effect = 1
EffectArg = "quest.iron.bounty"
Goto = "bounty_accepted"

[sub_resource type="Resource" id="ch_bounty_decline"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_bounty_decline"

[sub_resource type="Resource" id="ch_bounty_accepted_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_bounty_active_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_bounty_thanks_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_escort_offer"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_escort_offer"
Condition = 1
ConditionArg = "quest.iron.escort"
Goto = "escort_offer"

[sub_resource type="Resource" id="ch_escort_active"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_escort_active"
Condition = 2
ConditionArg = "quest.iron.escort"
Goto = "escort_active"

[sub_resource type="Resource" id="ch_escort_thanks"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_escort_thanks"
Condition = 3
ConditionArg = "quest.iron.escort"
Goto = "escort_thanks"

; ⚠️ Two effects, two nodes — a DialogueChoice carries ONE, exactly as Sedge's ledger-run fork does
; (41B): accepting starts the quest, and the NEXT node's only choice recruits Netta into the party.
[sub_resource type="Resource" id="ch_escort_accept"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_escort_accept"
Effect = 1
EffectArg = "quest.iron.escort"
Goto = "escort_accepted"

[sub_resource type="Resource" id="ch_escort_decline"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_escort_decline"

[sub_resource type="Resource" id="ch_escort_recruit"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_escort_recruit"
Effect = 5
EffectArg = "companion.iron_client"

[sub_resource type="Resource" id="ch_escort_active_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_escort_thanks_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_judgment_offer"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_offer"
Condition = 1
ConditionArg = "quest.iron.judgment"
Goto = "judgment_gate"

[sub_resource type="Resource" id="ch_judgment_active"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_active"
Condition = 2
ConditionArg = "quest.iron.judgment"
Goto = "judgment_active"

[sub_resource type="Resource" id="ch_judgment_thanks"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_thanks"
Condition = 3
ConditionArg = "quest.iron.judgment"
Goto = "judgment_thanks"

; ⚠️ THE GATE AllowsOneShotTarget PROMISES (quest.iron.judgment's header). MissingFlag/HasFlag on
; Corran's own DefeatFlagId — the one thing that turns "someone already killed him" into a fact this
; conversation can read, with no new state of its own.
[sub_resource type="Resource" id="ch_judgment_open"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_open"
Condition = 6
ConditionArg = "flag.iron.judgment_target_dead"
Goto = "judgment_offer"

[sub_resource type="Resource" id="ch_judgment_closed"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_closed"
Condition = 5
ConditionArg = "flag.iron.judgment_target_dead"
Goto = "judgment_closed"

[sub_resource type="Resource" id="ch_judgment_accept"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_accept"
Effect = 1
EffectArg = "quest.iron.judgment"
Goto = "judgment_accepted"

[sub_resource type="Resource" id="ch_judgment_decline"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_judgment_decline"

[sub_resource type="Resource" id="ch_judgment_closed_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_judgment_accepted_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_judgment_active_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

[sub_resource type="Resource" id="ch_judgment_thanks_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_fixer.c_end"

