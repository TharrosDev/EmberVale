[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Innkeeper Holt (service.ember_crown.inn). Scaffold from tools/gen_merchant_dialogue.py --service; prose is hand-written
; in data/locale/strings.csv.
;
; The service shape (38R), and what differs from the merchant one above it is the whole point:
;   - the door carries Effect = 10 (OpenService) and NO Goto, for the merchant shape's reason: a
;     Goto leaves this conversation open behind whatever window the service opens, and the player
;     lands back in it on close. --validate refuses it.
;   - there are NO hours and no closed node. Services keep none by design (DESIGN.md section 6), so
;     there is no ShopOpen equivalent to gate on and no closed line to write.
;   - the price is NOT in the graph. A walk-up ServiceComponent prompt derives it from standing;
;     a conversation says it in authored prose, so the number lives in the locale row and the
;     refusals (hostile, already held, cannot afford) are silent here on purpose.

; ⚠️ 41A ADDED THE WORD-TO-THE-WHARF LINE, AND IT IS THE FIRST QUEST THIS FILE HAS CARRIED.
; It follows the Elder's four-state shape exactly - offer / accepted / inprogress / thanks, gated on
; QuestAvailable (1) / QuestActive (2) / QuestCompleted (3) - because that shape is what makes a giver
; readable at every point in a quest's life. A giver with only an offer node tells the player nothing
; once they have accepted, which reads as the conversation being broken.

[sub_resource type="Resource" id="ch_use"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.c_use"
Effect = 10
EffectArg = "service.ember_crown.inn"

[sub_resource type="Resource" id="ch_talk"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.c_talk"
Goto = "talk"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.c_bye"

[sub_resource type="Resource" id="ch_talk_use"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.c_talk_use"
Effect = 10
EffectArg = "service.ember_crown.inn"

[sub_resource type="Resource" id="ch_talk_back"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.c_talk_back"
Goto = "root"

[sub_resource type="Resource" id="ch_talk_bye"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.c_talk_bye"

[sub_resource type="Resource" id="ch_word_offer"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_offer"
Goto = "word_offer"
Condition = 1
ConditionArg = "quest.hollowreach.word"

[sub_resource type="Resource" id="ch_word_active"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_active"
Goto = "word_inprogress"
Condition = 2
ConditionArg = "quest.hollowreach.word"

[sub_resource type="Resource" id="ch_word_thanks"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_thanks"
Goto = "word_thanks"
Condition = 3
ConditionArg = "quest.hollowreach.word"

[sub_resource type="Resource" id="ch_word_accept"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_accept"
Goto = "word_accepted"
Effect = 1
EffectArg = "quest.hollowreach.word"

[sub_resource type="Resource" id="ch_word_decline"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_decline"

[sub_resource type="Resource" id="ch_word_accepted_bye"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_accepted_bye"

[sub_resource type="Resource" id="ch_word_inprogress_bye"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_inprogress_bye"

[sub_resource type="Resource" id="ch_word_thanks_bye"]
script = ExtResource("3_choice")
Text = "dlg.innkeeper.word.c_thanks_bye"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.innkeeper.root"
Choices = Array[Resource]([SubResource("ch_word_thanks"), SubResource("ch_word_offer"), SubResource("ch_word_active"), SubResource("ch_use"), SubResource("ch_talk"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_talk"]
script = ExtResource("2_node")
Id = "talk"
Text = "dlg.innkeeper.talk"
Choices = Array[Resource]([SubResource("ch_talk_use"), SubResource("ch_talk_back"), SubResource("ch_talk_bye")])

[sub_resource type="Resource" id="node_word_offer"]
script = ExtResource("2_node")
Id = "word_offer"
Text = "dlg.innkeeper.word.offer"
Choices = Array[Resource]([SubResource("ch_word_accept"), SubResource("ch_word_decline")])

[sub_resource type="Resource" id="node_word_accepted"]
script = ExtResource("2_node")
Id = "word_accepted"
Text = "dlg.innkeeper.word.accepted"
Choices = Array[Resource]([SubResource("ch_word_accepted_bye")])

[sub_resource type="Resource" id="node_word_inprogress"]
script = ExtResource("2_node")
Id = "word_inprogress"
Text = "dlg.innkeeper.word.inprogress"
Choices = Array[Resource]([SubResource("ch_word_inprogress_bye")])

[sub_resource type="Resource" id="node_word_thanks"]
script = ExtResource("2_node")
Id = "word_thanks"
Text = "dlg.innkeeper.word.thanks"
Choices = Array[Resource]([SubResource("ch_word_thanks_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.innkeeper"
SpeakerName = "dlg.innkeeper.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_talk"), SubResource("node_word_offer"), SubResource("node_word_accepted"), SubResource("node_word_inprogress"), SubResource("node_word_thanks")])
