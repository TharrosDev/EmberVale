[sub_resource type="Resource" id="ch_trial_declined_bye"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_end"

[sub_resource type="Resource" id="ch_trial_active_bye"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_end"

[sub_resource type="Resource" id="ch_trial_admit"]
