[resource]
script = ExtResource("1_dlg")
Id = "dialogue.archive_keeper"
SpeakerName = "dlg.archive_keeper.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_member"), SubResource("node_stranger"), SubResource("node_trial_offer"), SubResource("node_trial_accepted"), SubResource("node_trial_declined"), SubResource("node_trial_active"), SubResource("node_trial_ready"), SubResource("node_admitted"), SubResource("node_advance"), SubResource("node_advance_ranked"), SubResource("node_h42_a_offer"), SubResource("node_h42_a_accepted"), SubResource("node_h42_a_active"), SubResource("node_h42_hub"), SubResource("node_h42_b_offer"), SubResource("node_h42_b_accepted"), SubResource("node_h42_b_active"), SubResource("node_h42_b_report"), SubResource("node_h42_verdict"), SubResource("node_h42_v_custody_preserve"), SubResource("node_h42_after_custody_preserve"), SubResource("node_h42_v_custody_share"), SubResource("node_h42_after_custody_share"), SubResource("node_h42_v_custody_seal"), SubResource("node_h42_after_custody_seal"), SubResource("node_h42_sealed"), SubResource("node_h42_ranked"), SubResource("node_pages_key"), SubResource("node_pages_key_why"), SubResource("node_pages_key_member")])
StartVariants = Array[Resource]([SubResource("start_0"), SubResource("start_1")])
