[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Keeper Ysolde Marr (faction.veiled_archive). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.veiled_archive:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.
;
; ── 42G: admission off the stranger line ─────────────────────────────────────────────────────────
; The Keeper's own 42B line — "A person joins us by bringing us something we did not have" — is the
; whole brief, so admission hangs off HER stranger branch rather than the contact's: ch_trial_offer /
; ch_trial_active / ch_trial_ready mirror dlg.ancient.root's own QuestAvailable/QuestActive/
; QuestCompleted triple on quest.veiled_archive.lost_tome, and are exhaustive for exactly the same
; reason that one is. ch_trial_admit carries Condition = 16 (GuildCanJoin) because Goto fires even
; when JoinGuild refuses (42I checkpoint fix; RejoinAllowed = false on this faction makes the refusal
; real, not theoretical) — --validate enforces the pairing.
;
; ── 42G: rank one and a recovered spell, off the member line ────────────────────────────────────
; ch_advance is a THIRD branch inside `member`, never a narrowing of ch_member's own condition (42B/
; 42C's own carried-forward warning). It is reachable once quest.veiled_archive.ancient_lead is
; QuestCompleted; the two choices in `advance` read whichever of the mutually exclusive outcome flags
; the quest's own report objectives already required (spared: flag.ancient.taught; killed:
; flag.ancient_dragon_defeated) and both carry Effect = 8 (LearnSpell, spell.elder_word) — idempotent
; if the player already knows it from dialogue.ancient_dragon directly, which is how "duplicate spell
; reward" is handled for free. `advance_ranked`'s one choice carries Effect = 12 (GuildRank), the
; two-node split 42I's own retrospective named: a DialogueChoice carries one Effect, so the spell and
; the rank cannot both fire from the same choice.

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_member"
Condition = 14
ConditionArg = "faction.veiled_archive:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_stranger"
Condition = 15
ConditionArg = "faction.veiled_archive"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_end"

[sub_resource type="Resource" id="ch_trial_offer"]
script = ExtResource("3_choice")
Text = "dlg.archive_keeper.c_trial_offer"
Condition = 1
ConditionArg = "quest.veiled_archive.lost_tome"
Goto = "trial_offer"

[sub_resource type="Resource" id="ch_trial_active"]
script = ExtResource("3_choice")
