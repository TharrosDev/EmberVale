[resource]
script = ExtResource("1_dlg")
Id = "dialogue.archive_keeper"
SpeakerName = "dlg.archive_keeper.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_member"), SubResource("node_stranger"), SubResource("node_trial_offer"), SubResource("node_trial_accepted"), SubResource("node_trial_declined"), SubResource("node_trial_active"), SubResource("node_trial_ready"), SubResource("node_admitted"), SubResource("node_advance"), SubResource("node_advance_ranked")])
