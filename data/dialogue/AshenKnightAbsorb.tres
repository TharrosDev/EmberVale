[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; The Ashen Knight's defeat (the finish run, Act IV). Modelled on dialogue.iron_king_absorb, with one
; node in front of the offer: the rival's last words. He is the only Flamebearer who speaks after he
; falls, because he is the only one who ever thought of the player as an equal.
; Phase 47.5: two optional choices on his last words remember the Act II duels (Condition 5 =
; HasFlag flag.rival.duel1_won / duel2_won); a player who skipped them never sees either.
; Condition 6 = MissingFlag (the offer cannot be taken twice); Effect 4 = AddCorruption; Effect 2 = SetFlag.
[sub_resource type="Resource" id="ch_listen"]
script = ExtResource("3_choice")
Text = "dlg.ashenknight.absorb.c_listen"
Goto = "last_words_2"

[sub_resource type="Resource" id="ch_duel_storm"]
script = ExtResource("3_choice")
Text = "dlg.ashenknight.absorb.c_duel_storm"
Goto = "duel_storm"
Condition = 5
ConditionArg = "flag.rival.duel1_won"

[sub_resource type="Resource" id="ch_duel_mission"]
script = ExtResource("3_choice")
Text = "dlg.ashenknight.absorb.c_duel_mission"
Goto = "duel_mission"
Condition = 5
ConditionArg = "flag.rival.duel2_won"

[sub_resource type="Resource" id="ch_duel_storm_back"]
script = ExtResource("3_choice")
Text = "dlg.ashenknight.absorb.c_listen"
Goto = "last_words_2"

[sub_resource type="Resource" id="ch_duel_mission_back"]
script = ExtResource("3_choice")
Text = "dlg.ashenknight.absorb.c_listen"
Goto = "last_words_2"

[sub_resource type="Resource" id="ch_go_on"]
script = ExtResource("3_choice")
Text = "dlg.ashenknight.absorb.c_go_on"
Goto = "offer"

[sub_resource type="Resource" id="ch_absorb"]
