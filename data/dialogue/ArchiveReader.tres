[resource]
script = ExtResource("1_dlg")
Id = "dialogue.archive_reader"
SpeakerName = "dlg.archive_reader.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_member"), SubResource("node_stranger"), SubResource("node_survey_offer"), SubResource("node_survey_accepted"), SubResource("node_survey_declined"), SubResource("node_survey_active"), SubResource("node_lead_offer"), SubResource("node_lead_accepted"), SubResource("node_lead_declined"), SubResource("node_lead_active"), SubResource("node_mg_teach"), SubResource("node_mg_taught")])
