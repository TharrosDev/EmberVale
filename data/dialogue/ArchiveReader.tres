[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Ferris Vail (faction.veiled_archive). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.veiled_archive:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.
;
; ── 42G: the member's fieldwork ──────────────────────────────────────────────────────────────────
; His own 42B member line — "there is a thing to go and settle, and settling things is what the Keeper
; sends us out to do" — is the contact role 42B declared and left empty; this is what he sends a member
; out to do, twice. Both offers are QuestAvailable/QuestActive pairs (ch_survey_*/ch_lead_*), exhaustive
; the same way dlg.syndicate_broker's rotation is: quest.veiled_archive.ancient_lead's own
; PrerequisiteQuestId keeps its QuestAvailable false until ley_survey is complete, so at most one pair
; is ever live — the visible rotation IS the reading order, same as 42I's three contracts.
; Admission itself is NOT here — that is Keeper Ysolde Marr's own door (ArchiveKeeper.tres), and the
; stranger branch below is untouched from 42B on purpose: a non-member gets nothing from Ferris.

; Magic upgrade: this NPC teaches spellcraft (spell.teach.* strings, LearnSpell effect).
[sub_resource type="Resource" id="ch_mg_menu"]
script = ExtResource("3_choice")
Text = "spell.teach.ask_menu"
Goto = "mg_teach"

[sub_resource type="Resource" id="ch_mg_null_lance"]
script = ExtResource("3_choice")
Text = "spell.null_lance.ask"
Goto = "mg_taught"
Effect = 8
EffectArg = "spell.null_lance"

[sub_resource type="Resource" id="ch_mg_back"]
script = ExtResource("3_choice")
Text = "spell.teach.back"
Goto = "root"

[sub_resource type="Resource" id="ch_mg_thanks"]
script = ExtResource("3_choice")
Text = "spell.teach.thanks"
Goto = "root"

[sub_resource type="Resource" id="node_mg_teach"]
script = ExtResource("2_node")
Id = "mg_teach"
Text = "spell.teach.archive_reader"
Choices = Array[Resource]([SubResource("ch_mg_null_lance"), SubResource("ch_mg_back")])

[sub_resource type="Resource" id="node_mg_taught"]
script = ExtResource("2_node")
Id = "mg_taught"
Text = "spell.teach.archive_reader.taught"
Choices = Array[Resource]([SubResource("ch_mg_thanks")])

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_member"
Condition = 14
ConditionArg = "faction.veiled_archive:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_stranger"
Condition = 15
ConditionArg = "faction.veiled_archive"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_end"

[sub_resource type="Resource" id="ch_survey_offer"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_survey_offer"
Condition = 1
ConditionArg = "quest.veiled_archive.ley_survey"
Goto = "survey_offer"

[sub_resource type="Resource" id="ch_survey_active"]
script = ExtResource("3_choice")
