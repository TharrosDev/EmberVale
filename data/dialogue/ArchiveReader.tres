[sub_resource type="Resource" id="ch_survey_declined_bye"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_end"

[sub_resource type="Resource" id="ch_survey_active_bye"]
script = ExtResource("3_choice")
Text = "dlg.archive_reader.c_end"

[sub_resource type="Resource" id="ch_lead_offer"]
