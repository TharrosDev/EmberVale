[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; The Ashen Knight yields after the second duel (Phase 47.5), boss.ashen_knight_duel2's
; DefeatDialogueId, once flag.rival.duel2_won is set.

[sub_resource type="Resource" id="ch_follow"]
script = ExtResource("3_choice")
Text = "dlg.rival.duel2.c_follow"
Goto = "follow"

[sub_resource type="Resource" id="ch_stair"]
script = ExtResource("3_choice")
Text = "dlg.rival.duel2.c_stair"
Goto = "stair"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.rival.duel2.c_bye"
Goto = ""

[sub_resource type="Resource" id="node_yield"]
script = ExtResource("2_node")
Id = "yield"
Text = "dlg.rival.duel2.yield"
Choices = Array[Resource]([SubResource("ch_follow")])

[sub_resource type="Resource" id="node_follow"]
script = ExtResource("2_node")
Id = "follow"
Text = "dlg.rival.duel2.follow"
Choices = Array[Resource]([SubResource("ch_stair")])

[sub_resource type="Resource" id="node_stair"]
script = ExtResource("2_node")
Id = "stair"
Text = "dlg.rival.duel2.stair"
Choices = Array[Resource]([SubResource("ch_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.rival_duel2"
SpeakerName = "dlg.rival.duel2.speaker"
StartNodeId = "yield"
Nodes = Array[Resource]([SubResource("node_yield"), SubResource("node_follow"), SubResource("node_stair")])
