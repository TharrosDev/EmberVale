[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Warder Cass Vollen (faction.emberbound). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.emberbound:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.

; Magic upgrade: this NPC teaches spellcraft (spell.teach.* strings, LearnSpell effect).
[sub_resource type="Resource" id="ch_mg_menu"]
script = ExtResource("3_choice")
Text = "spell.teach.ask_menu"
Goto = "mg_teach"

[sub_resource type="Resource" id="ch_mg_pyre_wall"]
script = ExtResource("3_choice")
Text = "spell.pyre_wall.ask"
Goto = "mg_taught"
Effect = 8
EffectArg = "spell.pyre_wall"

[sub_resource type="Resource" id="ch_mg_back"]
script = ExtResource("3_choice")
Text = "spell.teach.back"
Goto = "root"

[sub_resource type="Resource" id="ch_mg_thanks"]
script = ExtResource("3_choice")
Text = "spell.teach.thanks"
Goto = "root"

[sub_resource type="Resource" id="node_mg_teach"]
script = ExtResource("2_node")
Id = "mg_teach"
Text = "spell.teach.emberbound_warder"
Choices = Array[Resource]([SubResource("ch_mg_pyre_wall"), SubResource("ch_mg_back")])

[sub_resource type="Resource" id="node_mg_taught"]
script = ExtResource("2_node")
Id = "mg_taught"
Text = "spell.teach.emberbound_warder.taught"
Choices = Array[Resource]([SubResource("ch_mg_thanks")])

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_member"
Condition = 14
ConditionArg = "faction.emberbound:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_stranger"
Condition = 15
ConditionArg = "faction.emberbound"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_end"

; -- Phase 42L/42M: Cass Vollen on custody (quest.emberbound.second_fire's Talk) and on the Flamekeeper. --

[sub_resource type="Resource" id="ch_l42_account"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_l42_account"
Condition = 2
ConditionArg = "quest.emberbound.second_fire"
Goto = "l42_account"

[sub_resource type="Resource" id="ch_l42_react"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_warder.c_l42_react"
Condition = 14
ConditionArg = "faction.emberbound:3"
Goto = "l42_react"

[sub_resource type="Resource" id="node_l42_account"]
script = ExtResource("2_node")
Id = "l42_account"
Text = "dlg.emberbound_warder.l42_account"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_l42_react"]
script = ExtResource("2_node")
Id = "l42_react"
Text = "dlg.emberbound_warder.l42_react"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.emberbound_warder.root"
Choices = Array[Resource]([SubResource("ch_member"), SubResource("ch_stranger"), SubResource("ch_mg_menu"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_member"]
script = ExtResource("2_node")
Id = "member"
Text = "dlg.emberbound_warder.member"
Choices = Array[Resource]([SubResource("ch_l42_account"), SubResource("ch_l42_react"), SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_stranger"]
script = ExtResource("2_node")
Id = "stranger"
Text = "dlg.emberbound_warder.stranger"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.emberbound_warder"
SpeakerName = "dlg.emberbound_warder.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_member"), SubResource("node_stranger"), SubResource("node_l42_account"), SubResource("node_l42_react"), SubResource("node_mg_teach"), SubResource("node_mg_taught")])
