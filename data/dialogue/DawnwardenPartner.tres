[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Bram Corrow (faction.dawnwardens, RankPeerNpcId). Phase 42C.
;
; He carries the whole probation arc so no fact about it has two owners: the offer, the fork, the
; objectives (quest.dawnwardens.probation) and the rank-one grant are all one conversation graph.
; The root keeps the standard member/stranger split (Condition 14/15, rank 0, exhaustive) exactly as
; every other officer's does — he will not discuss guild work with someone who has not joined.
;
; ⚠️ THE FORK IS DECIDED BEFORE THE QUEST EXISTS, the barrels shape (41D / quest.hollowreach.barrels):
; ch_fork_rescue/ch_fork_expedient each set ONE flag and go to a "_go" node whose one choice starts
; the quest (Effect = 1). The two fork choices gate on EACH OTHER (Condition 6, MissingFlag) so a
; player who picks a side and walks off without accepting still has only one door open on return.
; SequentialObjectives on the quest means neither Reach objective can complete before the Defend does,
; regardless of how early the flag is set - the fight is still the fight.
;
; ⚠️ RANK ONE IS GRANTED ONLY ON COMPLETION, NOT ON THE FORK. The branch flag says which way the
; player chose; the rank comes from ch_claim_rescue/ch_claim_expedient, each gated on Condition 3
; (QuestCompleted) INSIDE the after-node the branch flag already picked - QuestCompleted is
; therefore true by construction wherever those two choices can be reached, without a compound
; condition existing anywhere. Neither branch pays a different reward (the quest's own
; FactionRewardId/Amount, faction.villagers, is one field) - Sedge's header already made that call
; for the same reason: a second place rewards live is invariant 5 waiting to happen. What differs is
; what Bram says, which is the consequence a player actually feels.
;
; ⚠️ NEITHER BRANCH TOUCHES THE IRON KING. The tension is the Dawnwardens' own - civilians first or
; the order kept, Danhal's silent argument with the world - and 42D is the one that gets to spend the
; Iron King's flags on it.

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_partner.c_member"
Condition = 14
ConditionArg = "faction.dawnwardens:0"
Goto = "member"

