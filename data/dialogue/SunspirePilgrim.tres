[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

[sub_resource type="Resource" id="ch_mission"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_pilgrim.c_mission"
Goto = "mission"

[sub_resource type="Resource" id="ch_mission_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_pilgrim.c_mission_bye"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_pilgrim.c_bye"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.sunspire_pilgrim.root"
Choices = Array[Resource]([SubResource("ch_mission"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_mission"]
script = ExtResource("2_node")
Id = "mission"
Text = "dlg.sunspire_pilgrim.mission"
Choices = Array[Resource]([SubResource("ch_mission_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.sunspire_pilgrim"
SpeakerName = "dlg.sunspire_pilgrim.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_mission")])
