[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Tessa Rill (Phase 41B), the escortee of quest.hollowreach.ledger.
;
; ⚠️ THE DISMISSAL IS THE LOAD-BEARING PART OF THIS FILE. An escort that ends with the escortee still
; in the party has not ended — she would follow the player into Frostfang Reach forever. The parting
; choice is gated Condition = 3 (QuestCompleted) so it cannot be taken to strand her halfway, and it
; carries Effect = 6 (DismissCompanion) with NO Goto: dismissing mid-conversation while the roster
; frees her body is the one place a Goto here could dereference something that has just gone away.

[sub_resource type="Resource" id="ch_hold"]
script = ExtResource("3_choice")
Text = "dlg.tessa.c_hold"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.tessa.c_bye"

[sub_resource type="Resource" id="ch_arrived"]
script = ExtResource("3_choice")
Text = "dlg.tessa.c_part"
Condition = 3
ConditionArg = "quest.hollowreach.ledger"
Goto = "arrived"

[sub_resource type="Resource" id="ch_part"]
script = ExtResource("3_choice")
Text = "dlg.tessa.c_part"
Effect = 6
EffectArg = "companion.tessa"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.tessa.root"
Choices = Array[Resource]([SubResource("ch_arrived"), SubResource("ch_hold"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_arrived"]
script = ExtResource("2_node")
Id = "arrived"
Text = "dlg.tessa.arrived"
Choices = Array[Resource]([SubResource("ch_part")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.tessa"
SpeakerName = "dlg.tessa.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_arrived")])
