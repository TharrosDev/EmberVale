[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Hierarch Selane Ott (faction.emberbound). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.emberbound:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.

; Magic upgrade: this NPC teaches spellcraft (spell.teach.* strings, LearnSpell effect).
[sub_resource type="Resource" id="ch_mg_menu"]
script = ExtResource("3_choice")
Text = "spell.teach.ask_menu"
Goto = "mg_teach"

[sub_resource type="Resource" id="ch_mg_ember_siphon"]
script = ExtResource("3_choice")
Text = "spell.ember_siphon.ask"
Goto = "mg_taught"
Condition = 7
ConditionArg = "40"
Effect = 8
EffectArg = "spell.ember_siphon"

[sub_resource type="Resource" id="ch_mg_back"]
script = ExtResource("3_choice")
Text = "spell.teach.back"
Goto = "root"

[sub_resource type="Resource" id="ch_mg_thanks"]
script = ExtResource("3_choice")
Text = "spell.teach.thanks"
Goto = "root"

[sub_resource type="Resource" id="node_mg_teach"]
script = ExtResource("2_node")
Id = "mg_teach"
Text = "spell.teach.emberbound_hierarch"
Choices = Array[Resource]([SubResource("ch_mg_ember_siphon"), SubResource("ch_mg_back")])

[sub_resource type="Resource" id="node_mg_taught"]
script = ExtResource("2_node")
Id = "mg_taught"
Text = "spell.teach.emberbound_hierarch.taught"
Choices = Array[Resource]([SubResource("ch_mg_thanks")])

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_member"
Condition = 14
ConditionArg = "faction.emberbound:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_stranger"
Condition = 15
ConditionArg = "faction.emberbound"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_end"

; ── 42K: the initiation, off the stranger line ──────────────────────────────────────────────────
; Gated on QuestCompleted (quest.emberbound.summons) rather than a hand-authored contact flag — Bren
; has already made contact by the time this is reachable, so completion of that one-objective quest
; IS "the order sent you here". Stays offered indefinitely once true: declining below is never
; terminal (GuildRules.CanJoin allows re-approaching a Refused guild by default, and Emberbound never
; overrides that), so a player who says no can come back.
[sub_resource type="Resource" id="ch_initiate"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_initiate"
Condition = 3
ConditionArg = "quest.emberbound.summons"
Goto = "initiate"

; The relic-handling choice. Both accepting branches converge on the same "joined" welcome — the
; choice is about doctrine, not admission, and is recorded as its own flag (relic_surrendered /
; relic_kept) for 42L's finale to read, not by gating membership on it. No item leaves the player's
; pack: the order asks for custody, it does not reach out and take it, so "surrendered" is a spoken
; vow the Warder will act on later (42L), and nothing here contradicts still holding the relic.
[sub_resource type="Resource" id="ch_relic_surrender"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_relic_surrender"
Effect = 2
EffectArg = "flag.emberbound.relic_surrendered"
Goto = "surrendered"

[sub_resource type="Resource" id="ch_relic_keep"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_relic_keep"
Effect = 2
EffectArg = "flag.emberbound.relic_kept"
Goto = "kept"

; A genuine third door: refusing the order outright, not just the relic. guild.emberbound.refused
; is the WRITE side of invariant 18 (GuildRules reads it back), the same shape Danhal's join/refuse
; door used in 42C before JoinGuild existed — there is no dedicated "refuse" effect and none is
; needed, since nothing else ever derives from this flag but GuildRules itself.
[sub_resource type="Resource" id="ch_refuse"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_refuse"
Effect = 2
EffectArg = "guild.emberbound.refused"
Goto = "declined"

[sub_resource type="Resource" id="ch_initiate_wait"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_initiate_wait"
Goto = "root"

; JoinGuild choices: Condition = GuildCanJoin (16) with the matching ConditionArg is required
; whenever a JoinGuild choice carries a Goto (--validate enforces the pairing, 42I checkpoint fix) —
; Goto fires even when the effect refuses.
[sub_resource type="Resource" id="ch_surrendered_confirm"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_surrendered_confirm"
Condition = 16
ConditionArg = "faction.emberbound"
Effect = 11
EffectArg = "faction.emberbound"
Goto = "joined"

[sub_resource type="Resource" id="ch_kept_confirm"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_kept_confirm"
Condition = 16
ConditionArg = "faction.emberbound"
Effect = 11
EffectArg = "faction.emberbound"
Goto = "joined"

; GuildRank is idempotent (42I), so a second visit here after promotion re-sets rank 1 rather than
; erroring — no HasFlag/MissingFlag pair against the derived rank flag is needed.
[sub_resource type="Resource" id="ch_joined_confirm"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_joined_confirm"
Effect = 12
EffectArg = "faction.emberbound:1"

[sub_resource type="Resource" id="ch_declined_bye"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.c_declined_bye"

; -- Phase 42 finale arc (faction.emberbound) --
; quest.emberbound.second_fire (rank two) then quest.emberbound.reckoning (rank three + finale). The accept choice gates on
; GuildRankAtLeast :1, so rank two (SetFlag, additive - never GuildRank :2, which CLEARS rank
; three on a revisit) cannot land on a gap. The verdict is given at the hand-in, after the quest,
; because no objective depends on it; flag.emberbound.verdict_given shuts the verdict door once given.
; DialoguePanel has CloseOnCancel = false, so the single-choice chain verdict -> seal ->
; GuildRank :3 -> SetFlag guild.emberbound.finale cannot be abandoned half way.

[sub_resource type="Resource" id="ch_l42_a_offer"]
script = ExtResource("3_choice")
Text = "dlg.emberbound_hierarch.l42_c_a_offer"
Condition = 4
ConditionArg = "quest.emberbound.second_fire"
Goto = "l42_a_offer"

