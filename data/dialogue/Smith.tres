[sub_resource type="Resource" id="ch_thanks"]
script = ExtResource("3_choice")
Text = "dlg.smith.c_thanks"
Goto = "thanks"
Condition = 3
ConditionArg = "quest.warband.forge"

; 38E: trade, on the root node under the quest lines and above the farewell. The quest is why the player
; was sent here; a trade line at the top buries it. No Goto — an OpenShop choice ends the conversation and
; the vendor window takes its place (--validate rejects one that points anywhere).
;
; 38J: the trade line is gated on Condition = 12 (ShopOpen) and a second line (13, ShopClosed) answers
; when the forge is cold. --validate requires the pairing — an OpenShop choice on a shop with hours and
; no ShopOpen condition is a line the player picks at 02:00 that silently does nothing.
[sub_resource type="Resource" id="ch_trade"]
script = ExtResource("3_choice")
Text = "dlg.smith.c_trade"
Condition = 12
ConditionArg = "shop.ember_crown.smith"
Effect = 9
EffectArg = "shop.ember_crown.smith"

[sub_resource type="Resource" id="ch_closed"]
script = ExtResource("3_choice")
Text = "dlg.smith.c_closed"
Condition = 13
ConditionArg = "shop.ember_crown.smith"
Goto = "closed"

; 38Q: the order bench. No Effect and no OpenShop — a commission is placed at the bench beside him,
; not in the conversation, because an entity gets one interactable and his is this dialogue. The line
; exists so the bench is discoverable by talking to the man, which is how a player finds anything in
; this town; ungated, because the bench answers "you know nothing I could make" on its own prompt and
; a second gate here would be a second authority on the same question.
[sub_resource type="Resource" id="ch_commission"]
script = ExtResource("3_choice")
Text = "dlg.smith.c_commission"
Goto = "commission"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.smith.c_bye"

