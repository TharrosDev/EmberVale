[sub_resource type="Resource" id="node_tally_thanks"]
script = ExtResource("2_node")
Id = "tally_thanks"
Text = "dlg.coyle.tally_thanks"
Choices = Array[Resource]([SubResource("ch_tally_thanks_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.coyle"
SpeakerName = "dlg.coyle.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_talk"), SubResource("node_closed"), SubResource("node_tally"), SubResource("node_tally_accepted"), SubResource("node_tally_inprogress"), SubResource("node_tally_thanks")])
