[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

[sub_resource type="Resource" id="ch_wells"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_wells"
Goto = "wells"

[sub_resource type="Resource" id="ch_wells_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_wells_bye"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_bye"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.sunspire_wellkeeper.root"
Choices = Array[Resource]([SubResource("ch_wells"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_wells"]
script = ExtResource("2_node")
Id = "wells"
Text = "dlg.sunspire_wellkeeper.wells"
Choices = Array[Resource]([SubResource("ch_wells_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.sunspire_wellkeeper"
SpeakerName = "dlg.sunspire_wellkeeper.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_wells")])
