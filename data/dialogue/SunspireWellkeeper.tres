[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

[sub_resource type="Resource" id="ch_wells"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_wells"
Goto = "wells"

[sub_resource type="Resource" id="ch_wells_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_wells_bye"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_bye"

; Phase 44.5: after-lines once the game is won, one per ending (Condition 5 = HasFlag).
[sub_resource type="Resource" id="ch_ending_dawnfire"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_ending"
Goto = "ending_dawnfire"
Condition = 5
ConditionArg = "flag.ending_dawnfire"

[sub_resource type="Resource" id="ch_ending_dawnfire_back"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_ending_back"
Goto = "root"

[sub_resource type="Resource" id="ch_ending_embers"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_ending"
Goto = "ending_embers"
Condition = 5
ConditionArg = "flag.ending_embers"

[sub_resource type="Resource" id="ch_ending_embers_back"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_wellkeeper.c_ending_back"
Goto = "root"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.sunspire_wellkeeper.root"
Choices = Array[Resource]([SubResource("ch_ending_dawnfire"), SubResource("ch_ending_embers"), SubResource("ch_wells"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_wells"]
script = ExtResource("2_node")
Id = "wells"
Text = "dlg.sunspire_wellkeeper.wells"
Choices = Array[Resource]([SubResource("ch_wells_bye")])

[sub_resource type="Resource" id="node_ending_dawnfire"]
script = ExtResource("2_node")
Id = "ending_dawnfire"
Text = "dlg.sunspire_wellkeeper.ending_dawnfire"
Choices = Array[Resource]([SubResource("ch_ending_dawnfire_back")])

[sub_resource type="Resource" id="node_ending_embers"]
script = ExtResource("2_node")
Id = "ending_embers"
Text = "dlg.sunspire_wellkeeper.ending_embers"
Choices = Array[Resource]([SubResource("ch_ending_embers_back")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.sunspire_wellkeeper"
SpeakerName = "dlg.sunspire_wellkeeper.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_wells"), SubResource("node_ending_dawnfire"), SubResource("node_ending_embers")])
