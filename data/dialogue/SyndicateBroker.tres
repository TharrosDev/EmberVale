[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueStartVariant.cs" id="9_variant"]

; Broker Ilder Vance (faction.iron_syndicate). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.iron_syndicate:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_member"
Condition = 14
ConditionArg = "faction.iron_syndicate:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_stranger"
Condition = 15
ConditionArg = "faction.iron_syndicate"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_end"

; ── 42I: recruitment off the stranger line ──────────────────────────────────────────────────────
; Two honest terminal states off one node, exactly as the ledger run's fork is (41B/41D): accept
; joins outright (Effect = 11, JoinGuild — the choke point that also enforces RejoinAllowed, so a
; console-driven refusal to take a left member back is never bypassed from dialogue), decline closes
; the conversation with nothing written. There is no separate "offered" flag: GuildNotMember (15)
; already re-opens this same door on the next visit, so nothing is lost by not recording the ask.
; ch_join carries Condition = 16 (GuildCanJoin) because Goto fires even when JoinGuild refuses; a
; player the guild will not take back must never reach joined_now (--validate enforces the pairing).
[sub_resource type="Resource" id="ch_join"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_join"
Goto = "joined_now"
Condition = 16
ConditionArg = "faction.iron_syndicate"
Effect = 11
EffectArg = "faction.iron_syndicate"

[sub_resource type="Resource" id="ch_join_decline"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_join_decline"
Goto = "declined"

[sub_resource type="Resource" id="ch_joined_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_end"

[sub_resource type="Resource" id="ch_declined_bye"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_end"

; ── 42I: rank one, off the member line ──────────────────────────────────────────────────────────
; Reachable only once all three of Grieve's postings are behind you (QuestCompleted on the last of
; the chain, quest.iron.judgment — PrerequisiteQuestId already makes that "all three", not "any
; one"). Effect = 12 (GuildRank) is idempotent, so a second visit after promotion re-sets the same
; rank flags rather than erroring; the text is written to read fine either way rather than as a
; one-time announcement, which is what let this skip a HasFlag/MissingFlag pair on the derived rank
; flag itself (NOW.md invariant 18).
[sub_resource type="Resource" id="ch_advance"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_advance"
Condition = 3
ConditionArg = "quest.iron.judgment"
Goto = "advance"

; Phase 42M: rank one is SetFlag (additive), not GuildRank :1 - this node is re-reachable, and GuildRank
; CLEARS every rank above the one it names, so a revisit after rank two or three would have demoted.
[sub_resource type="Resource" id="ch_advance_confirm"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.c_advance_confirm"
Effect = 2
EffectArg = "guild.iron_syndicate.rank1"

; -- Phase 42 finale arc (faction.iron_syndicate) --
; quest.iron.caravan_road (rank two) then quest.iron.last_contract (rank three + finale). The accept choice gates on
; GuildRankAtLeast :1, so rank two (SetFlag, additive - never GuildRank :2, which CLEARS rank
; three on a revisit) cannot land on a gap. The verdict is given at the hand-in, after the quest,
; because no objective depends on it; flag.iron_syndicate.verdict_given shuts the verdict door once given.
; DialoguePanel has CloseOnCancel = false, so the single-choice chain verdict -> seal ->
; GuildRank :3 -> SetFlag guild.iron_syndicate.finale cannot be abandoned half way.

[sub_resource type="Resource" id="ch_j42_a_offer"]
script = ExtResource("3_choice")
Text = "dlg.syndicate_broker.j42_c_a_offer"
Condition = 4
ConditionArg = "quest.iron.caravan_road"
Goto = "j42_a_offer"

