; 38E: trade, under the quest lines and above the farewell. No Goto — an OpenShop choice ends the
; conversation and the vendor window takes its place.
;
; 38J: gated on Condition = 12 (ShopOpen), with a ShopClosed line (13) for the hours she keeps. Hers is
; the shortest trading day in the realm, so this is the merchant the player meets shut most often.
[sub_resource type="Resource" id="ch_trade"]
script = ExtResource("3_choice")
Text = "dlg.apothecary.c_trade"
Condition = 12
ConditionArg = "shop.ember_crown.apothecary"
