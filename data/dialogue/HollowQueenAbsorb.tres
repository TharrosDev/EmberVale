[gd_resource type="Resource" script_class="DialogueResource" format=3 uid="uid://c0mhr77hqueenabs"]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Condition 6 = MissingFlag. The Hollow Queen's ember, authored exactly like the Iron King's (IronKingAbsorb.tres):
; first-time defeat, but the choice carries +25 corruption and corruption drives the endings, so the
; offer also refuses to appear once it has been taken. A second caller cannot resurrect the bug.
[sub_resource type="Resource" id="ch_absorb"]
script = ExtResource("3_choice")
Text = "dlg.hollowqueen.absorb.c_absorb"
Goto = "absorbed"
Condition = 6
ConditionArg = "flag.hollow_queen_absorbed"
Effect = 4
EffectArg = "25"

[sub_resource type="Resource" id="ch_decline"]
script = ExtResource("3_choice")
Text = "dlg.hollowqueen.absorb.c_decline"
Goto = "declined"

[sub_resource type="Resource" id="ch_absorbed_bye"]
script = ExtResource("3_choice")
Text = "dlg.hollowqueen.absorb.c_absorbed_bye"
Effect = 2
EffectArg = "flag.hollow_queen_absorbed"

[sub_resource type="Resource" id="ch_declined_bye"]
script = ExtResource("3_choice")
Text = "dlg.hollowqueen.absorb.c_declined_bye"

[sub_resource type="Resource" id="node_offer"]
script = ExtResource("2_node")
Id = "offer"
Text = "dlg.hollowqueen.absorb.offer"
Choices = Array[Resource]([SubResource("ch_absorb"), SubResource("ch_decline")])

[sub_resource type="Resource" id="node_absorbed"]
script = ExtResource("2_node")
Id = "absorbed"
Text = "dlg.hollowqueen.absorb.absorbed"
Choices = Array[Resource]([SubResource("ch_absorbed_bye")])

[sub_resource type="Resource" id="node_declined"]
script = ExtResource("2_node")
Id = "declined"
Text = "dlg.hollowqueen.absorb.declined"
Choices = Array[Resource]([SubResource("ch_declined_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.hollow_queen_absorb"
SpeakerName = "dlg.hollowqueen.absorb.speaker"
StartNodeId = "offer"
Nodes = Array[Resource]([SubResource("node_offer"), SubResource("node_absorbed"), SubResource("node_declined")])
