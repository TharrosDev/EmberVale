[ext_resource type="Script" path="res://src/Dialogue/DialogueStartVariant.cs" id="4_variant"]

; An undying resident of the hidden realm. Condition 5/6 = HasFlag/MissingFlag on the
; Queen's defeat: before it they speak of the bargain and the Court; after it, of release.
; Every key is under pale. (post-reveal text; see tools/world_atlas.py).

; Magic upgrade: this NPC teaches spellcraft (spell.teach.* strings, LearnSpell effect).
[sub_resource type="Resource" id="ch_mg_menu"]
script = ExtResource("3_choice")
Text = "spell.teach.ask_menu"
Goto = "mg_teach"

[sub_resource type="Resource" id="ch_mg_soul_tithe"]
script = ExtResource("3_choice")
Text = "spell.soul_tithe.ask"
Goto = "mg_taught"
Effect = 8
EffectArg = "spell.soul_tithe"

[sub_resource type="Resource" id="ch_mg_back"]
script = ExtResource("3_choice")
Text = "spell.teach.back"
Goto = "root"

[sub_resource type="Resource" id="ch_mg_thanks"]
script = ExtResource("3_choice")
Text = "spell.teach.thanks"
Goto = "root"

[sub_resource type="Resource" id="node_mg_teach"]
script = ExtResource("2_node")
Id = "mg_teach"
Text = "spell.teach.undying_steward"
