[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

[sub_resource type="Resource" id="ch_library"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_archivist.c_library"
Goto = "library"

[sub_resource type="Resource" id="ch_library_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_archivist.c_library_bye"

[sub_resource type="Resource" id="ch_prophet"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_archivist.c_prophet"
Goto = "prophet"

[sub_resource type="Resource" id="ch_prophet_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_archivist.c_prophet_bye"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.sunspire_archivist.c_bye"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.sunspire_archivist.root"
Choices = Array[Resource]([SubResource("ch_library"), SubResource("ch_prophet"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_library"]
script = ExtResource("2_node")
Id = "library"
Text = "dlg.sunspire_archivist.library"
Choices = Array[Resource]([SubResource("ch_library_bye")])

[sub_resource type="Resource" id="node_prophet"]
script = ExtResource("2_node")
Id = "prophet"
Text = "dlg.sunspire_archivist.prophet"
Choices = Array[Resource]([SubResource("ch_prophet_bye")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.sunspire_archivist"
SpeakerName = "dlg.sunspire_archivist.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_library"), SubResource("node_prophet")])
