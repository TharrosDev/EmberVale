[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Sedge Marrow (shop.hollowreach.hull). Scaffold from tools/gen_merchant_dialogue.py; prose is hand-written in
; data/locale/strings.csv.
;
; The standard resident-merchant shape, and every part of it is load-bearing:
;   - the trade choice carries Effect = 9 (OpenShop) and NO Goto. A Goto would leave this
;     conversation open behind the vendor window, returning the player to it when the shop closes.
;   - BOTH trade doors are gated on Condition = 12 (ShopOpen) naming the same shop id. A gate on one
;     of two doors is not a gate - the trap Aldreth's file records.
;   - Condition = 13 (ShopClosed) puts the closing time in the merchant's own mouth rather than
;     letting the option silently do nothing.

; ⚠️ THE LEDGER RUN IS TWO CHOICES DEEP AND THAT IS ON PURPOSE (41B). A DialogueChoice carries ONE
; effect, and this errand needs two things to happen - the quest starts, and Tessa joins the party -
; so accepting goes to a second node whose only choice recruits her. The root's Condition = 2
; (QuestActive) door back into that node is what covers the player who accepted and then walked off
; without her: without it, the quest would be live with nobody to escort and no way to fix it.

; ⚠️ 41D - THE BARRELS FORK, AND EVERY PART OF ITS SHAPE IS LOAD-BEARING.
;   - Two choices deep for the ledger run's reason: a DialogueChoice carries ONE effect, and this
;     errand needs a flag set AND a quest started. The flag goes on the fork choice, the quest starts
;     on the node it leads to - so the branch is decided BEFORE the quest exists and there is never a
;     frame where it is live with no path.
;   - The two fork choices gate on each OTHER (Condition = 6, MissingFlag). A player who picks a fork
;     and walks off has the flag but no quest; without this the other fork is still offered on their
;     return and BOTH paths end up live. It also gives that player their own way back to accept.
;   - The two aftermath doors (Condition = 5, HasFlag) are what makes the ending mean something. The
;     hushed one is paired with a flag-gated shelf on shop.hollowreach.hull; the declared one is the
;     honest road and costs you the shelf. Neither pays gold differently - see the quest's header.

[sub_resource type="Resource" id="ch_trade"]
script = ExtResource("3_choice")
Text = "dlg.sedge.c_trade"
Condition = 12
ConditionArg = "shop.hollowreach.hull"
Effect = 9
EffectArg = "shop.hollowreach.hull"

[sub_resource type="Resource" id="ch_closed"]
script = ExtResource("3_choice")
Text = "dlg.sedge.c_closed"
Condition = 13
ConditionArg = "shop.hollowreach.hull"
Goto = "closed"

[sub_resource type="Resource" id="ch_talk"]
script = ExtResource("3_choice")
Text = "dlg.sedge.c_talk"
Goto = "talk"

