[gd_resource type="Resource" script_class="DialogueResource" format=3]

[ext_resource type="Script" path="res://src/Dialogue/DialogueResource.cs" id="1_dlg"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueNode.cs" id="2_node"]
[ext_resource type="Script" path="res://src/Dialogue/DialogueChoice.cs" id="3_choice"]

; Serjeant Rook Danhal (faction.dawnwardens). Scaffold from tools/gen_guild_dialogue.py; prose is hand-written in
; data/locale/strings.csv. Phase 42B.
;
; The standard guild-officer shape:
;   - the ROOT line is a neutral hail. A DialogueResource has one StartNodeId and nothing
;     conditions it, so the membership-aware greeting is the first EXCHANGE rather than the first
;     line: exactly one of the two choices below is ever offered.
;   - Condition = 14 is GuildRankAtLeast ("faction.dawnwardens:0" - a member of ANY rank), Condition = 15
;     is GuildNotMember. Rank 0 keeps the pair exhaustive; see the generator header.
;     Never Condition = 5 (HasFlag) with a guild.* flag: those flags are DERIVED by GuildRules from
;     the faction id, and hand-writing one into a .tres is NOW.md invariant 18's whole subject.
;   - the two are exhaustive and disjoint, so root is never a dead end.

; 42C — THE JOIN/REFUSE DOOR. He is the ContactNpcId, so recruitment hangs off the "stranger" exchange
; rather than a new root branch: ch_join/ch_refuse fire Effect = 2 (SetFlag) with the exact strings
; GuildRules.OfferedFlag/JoinedFlag/RefusedFlag derive ("guild.dawnwardens.joined",
; "guild.dawnwardens.refused") — the WRITE side of invariant 18. StoryFlagsComponent stays the only
; writer; this is that write, not a second one. RejoinAllowed = true on the faction means a refused or
; departed member sees this same door again for free — GuildNotMember does not distinguish Refused
; from Unknown, and it should not have to.
;
; 42C — THE RANK-AWARE THIRD BRANCH. ch_ranked does not narrow ch_member (still rank 0, still
; exhaustive with ch_stranger) - it is an EXTRA choice inside "member", gated on
; "faction.dawnwardens:1", exactly the shape 42B's header warned the next rank-granting arc to use.

; 42D — A FOURTH, ADDITIVE BRANCH FOR THE POST-FINALE WORLD. ch_finale_state does not narrow
; ch_ranked (a rank-3 member satisfies "faction.dawnwardens:1" too, so both are offered together) -
; it is gated "faction.dawnwardens:3", the guild's declared ceiling (RankNameKeys.Count == 3), which
; only quest.dawnwardens.finale's completion ever reaches. finale_state itself branches once more on
; which of flag.dawnwardens.finale_service / finale_authority is set - exhaustive, because rank three
; is granted only after the fork already picked one. This is the Serjeant's half of 42D's "hub
; dialogue variant" (patrols answer to him); Captain Fenn carries the leadership half.

[sub_resource type="Resource" id="ch_member"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_member"
Condition = 14
ConditionArg = "faction.dawnwardens:0"
Goto = "member"

[sub_resource type="Resource" id="ch_stranger"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_stranger"
Condition = 15
ConditionArg = "faction.dawnwardens"
Goto = "stranger"

[sub_resource type="Resource" id="ch_bye"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_bye"

[sub_resource type="Resource" id="ch_back"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_back"
Goto = "root"

[sub_resource type="Resource" id="ch_end"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_end"

[sub_resource type="Resource" id="ch_join"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_join"
Effect = 2
EffectArg = "guild.dawnwardens.joined"
Goto = "joined"

[sub_resource type="Resource" id="ch_refuse"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_refuse"
Effect = 2
EffectArg = "guild.dawnwardens.refused"
Goto = "refused"

[sub_resource type="Resource" id="ch_joined_end"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_joined_end"

[sub_resource type="Resource" id="ch_refused_end"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_refused_end"

[sub_resource type="Resource" id="ch_ranked"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_ranked"
Condition = 14
ConditionArg = "faction.dawnwardens:1"
Goto = "ranked"

[sub_resource type="Resource" id="ch_finale_state"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_finale_state"
Condition = 14
ConditionArg = "faction.dawnwardens:3"
Goto = "finale_state"

[sub_resource type="Resource" id="ch_finale_state_service"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_finale_state_service"
Condition = 5
ConditionArg = "flag.dawnwardens.finale_service"
Goto = "finale_state_service"

[sub_resource type="Resource" id="ch_finale_state_authority"]
script = ExtResource("3_choice")
Text = "dlg.dawnwarden_serjeant.c_finale_state_authority"
Condition = 5
ConditionArg = "flag.dawnwardens.finale_authority"
Goto = "finale_state_authority"

[sub_resource type="Resource" id="node_root"]
script = ExtResource("2_node")
Id = "root"
Text = "dlg.dawnwarden_serjeant.root"
Choices = Array[Resource]([SubResource("ch_member"), SubResource("ch_stranger"), SubResource("ch_bye")])

[sub_resource type="Resource" id="node_member"]
script = ExtResource("2_node")
Id = "member"
Text = "dlg.dawnwarden_serjeant.member"
Choices = Array[Resource]([SubResource("ch_ranked"), SubResource("ch_finale_state"), SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_stranger"]
script = ExtResource("2_node")
Id = "stranger"
Text = "dlg.dawnwarden_serjeant.stranger"
Choices = Array[Resource]([SubResource("ch_join"), SubResource("ch_refuse"), SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_joined"]
script = ExtResource("2_node")
Id = "joined"
Text = "dlg.dawnwarden_serjeant.joined"
Choices = Array[Resource]([SubResource("ch_joined_end")])

[sub_resource type="Resource" id="node_refused"]
script = ExtResource("2_node")
Id = "refused"
Text = "dlg.dawnwarden_serjeant.refused"
Choices = Array[Resource]([SubResource("ch_refused_end")])

[sub_resource type="Resource" id="node_ranked"]
script = ExtResource("2_node")
Id = "ranked"
Text = "dlg.dawnwarden_serjeant.ranked"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_finale_state"]
script = ExtResource("2_node")
Id = "finale_state"
Text = "dlg.dawnwarden_serjeant.finale_state"
Choices = Array[Resource]([SubResource("ch_finale_state_service"), SubResource("ch_finale_state_authority"), SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_finale_state_service"]
script = ExtResource("2_node")
Id = "finale_state_service"
Text = "dlg.dawnwarden_serjeant.finale_state_service"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[sub_resource type="Resource" id="node_finale_state_authority"]
script = ExtResource("2_node")
Id = "finale_state_authority"
Text = "dlg.dawnwarden_serjeant.finale_state_authority"
Choices = Array[Resource]([SubResource("ch_back"), SubResource("ch_end")])

[resource]
script = ExtResource("1_dlg")
Id = "dialogue.dawnwarden_serjeant"
SpeakerName = "dlg.dawnwarden_serjeant.speaker"
StartNodeId = "root"
Nodes = Array[Resource]([SubResource("node_root"), SubResource("node_member"), SubResource("node_stranger"), SubResource("node_joined"), SubResource("node_refused"), SubResource("node_ranked"), SubResource("node_finale_state"), SubResource("node_finale_state_service"), SubResource("node_finale_state_authority")])
