[ext_resource type="Script" path="res://src/Enemies/AIProfileResource.cs" id="1_profile"]

; The slowest, most deliberate of the three dragons. It has the widest vision in the game and the
; lowest turn rate: it sees you coming from the far side of its aerie and cannot be surprised, but
; once it commits to a swing it is committed, and 35A's flank and rear arcs are wide open to anyone
; willing to keep moving. That is the fight an old creature should be.
;
; It also spends the most time on the ground — a conversation is impossible with something circling
; at 24 m, and the aerie is where it lives rather than where it hunts.
;
; TerritoryRadius 44 against a 90 m floor: the leash breaks off well inside its own ground, so a
; chase can never spill over the cell edge into the void or a neighbour's props (the 35D/35E rule).
[resource]
script = ExtResource("1_profile")
Id = "ai.ancient_dragon"
VisionRange = 70.0
FovDegrees = 170.0
AlertRadius = 40.0
AttackRange = 6.5
PatrolRadius = 6.0
TurnSpeedDegrees = 35.0
; Hover and take-off range follow the body (22 m, 14 m and 11 m dragons, not three 5 m ones). The
; climb speed rose by the same ratio as the altitude, so the climb and the descent take the seconds
; they always took and the airborne window is still the profile's own number.
TakeoffRange = 24.0
HoverAltitude = 24.0
ClimbSpeed = 9.2
AirborneDuration = 4.0
GroundedDuration = 10.0
TerritoryRadius = 44.0
RetreatHealthFraction = 0.0
ProvokeMemory = 45.0
ActiveDistance = 120.0
