[ext_resource type="Script" path="res://src/Enemies/AIProfileResource.cs" id="1_profile"]

; The slowest, most deliberate of the three dragons. It has the widest vision in the game and the
; lowest turn rate: it sees you coming from the far side of its aerie and cannot be surprised, but
; once it commits to a swing it is committed, and 35A's flank and rear arcs are wide open to anyone
; willing to keep moving. That is the fight an old creature should be.
;
; It also spends the most time on the ground — a conversation is impossible with something circling
; overhead, and the aerie is where it lives rather than where it hunts.
;
; TerritoryRadius 44 against a 90 m floor: the leash breaks off well inside its own ground, so a
; chase can never spill over the cell edge into the void or a neighbour's props (the 35D/35E rule).
[resource]
script = ExtResource("1_profile")
Id = "ai.ancient_dragon"
VisionRange = 70.0
FovDegrees = 170.0
AlertRadius = 40.0
AttackRange = 6.5
PatrolRadius = 6.0
TurnSpeedDegrees = 35.0
; Take-off range follows the body (22 m, 14 m and 11 m dragons, not three 5 m ones): it is the
; planar distance past which the dragon flies, not a height.
; HoverAltitude is set by the breath, not by the body. The cone is 12 m long and leaves the mouth,
; which rides 8 m above the body origin and 9.8 m ahead of it, so at this hover the mouth is
; 1.5 m inside the cone's reach of a standing target's chest and the breath covers about 5.8 m
; around the point under the jaw. Higher than this the air phase cannot touch the ground at all
; (it was cosmetic at the old hover). The body stands 10.6 m tall, so this is a low hover: raising
; it means lengthening the breath's ImpactRadius in data/spells by the same metres.
; The climb speed keeps the climb and the descent at the seconds they always took.
TakeoffRange = 24.0
HoverAltitude = 3.5
ClimbSpeed = 1.35
AirborneDuration = 4.0
GroundedDuration = 10.0
TerritoryRadius = 44.0
RetreatHealthFraction = 0.0
ProvokeMemory = 45.0
ActiveDistance = 120.0
