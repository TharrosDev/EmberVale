[gd_resource type="Resource" script_class="EnemyArchetypeResource" format=3 uid="uid://cmbrvlenmbeastlord"]

[ext_resource type="Script" path="res://src/Enemies/EnemyArchetypeResource.cs" id="1_archetype"]

; The Beast Lord, the Fourth Flamebearer: "Accepted corruption. Became a monster." (docs/LORE.md)
;
; ⚠️ THE BODY IS A PLACEHOLDER. It is the dire wolf's adopted model at 2.2x through ModelScale,
; so the fight is complete and playable now. When a generated boss body
; lands, swap ModelPath and ModelScale and re-fit the capsule.
;
; No LootTablePath: like the Iron King, his reward is the relic his BossResource grants.

[resource]
script = ExtResource("1_archetype")
Id = "enemy.beast_lord"
NameKey = "enemy.beast_lord.name"
AttributesPath = "res://data/attributes/BeastLordAttributes.tres"
WeaponPath = "res://data/weapons/BeastLordClaws.tres"
LootTablePath = "res://data/loot/bosses/BeastLordBossLoot.tres"
ModelPath = "res://assets/models/creatures/boss_beast_lord.glb"
ModelScale = 1.5
PlaceholderTint = Color(0.2, 0.15, 0.14, 1)
AiProfileId = "ai.boss"
FactionId = "faction.beasts"
KnownSpellIds = Array[String]([])
BreathSpellId = ""
DialogueId = ""
CapsuleRadius = 1.1
CapsuleHeight = 3.67
IsBoss = true
BossId = "boss.beast_lord"
DirectionalMelee = false
MaxPoise = 170.0
Reaction = 4
StaminaRegen = 18.0
XpValue = 750
; Look and reach are separate (EnemyArchetypeResource.VisualHeight). The model is drawn at
; ModelScale 1.5 (3 m -> 4.5 m); the capsule grew by sqrt(1.5) only
; (0.9 x 3 -> 1.1 x 3.67), because the melee hitbox, the telegraph ring and the nav
; agent all derive from the capsule and AttackRange is not changed. VisualHeight is what the
; hurtbox, the plate, status marks, the cast origin and the lock camera read.
VisualHeight = 4.5
