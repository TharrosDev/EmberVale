[ext_resource type="Script" path="res://src/Enemies/EnemyArchetypeResource.cs" id="1_archetype"]
[ext_resource type="Script" path="res://src/Enemies/HitZoneResource.cs" id="2_zone"]

; Bigger than the Wild dragon in every dimension. The zone multipliers are deliberately FLATTER —
; the head is still the weak point but only x1.6, and the tail no longer shrugs hits off at x0.6.
; A corrupted thing has no good side to be on, which is what makes it the harder fight even before
; the numbers.
[sub_resource type="Resource" id="Zone_head"]
script = ExtResource("2_zone")
Id = "head"
DamageMultiplier = 1.6
Offset = Vector3(0, 5.3, -4.4)
Radius = 1.7
Height = 0.0

; The neck and the torso are the old body zone's multiplier on the parts of a long body an upright
; capsule cannot reach: an arrow that passed through the dragon's neck used to hit nothing.
[sub_resource type="Resource" id="Zone_neck"]
script = ExtResource("2_zone")
Id = "neck"
DamageMultiplier = 1.0
Offset = Vector3(0, 4.7, -2.75)
Radius = 0.9
Height = 3.6
RotationDegrees = Vector3(-56.3, 0, 0)

; One capsule across both wings at the height they are carried.
[sub_resource type="Resource" id="Zone_wings"]
script = ExtResource("2_zone")
Id = "wings"
DamageMultiplier = 1.2
Offset = Vector3(0, 5, 1.6)
Radius = 2.4
Height = 9.4
RotationDegrees = Vector3(0, 0, 90)

[sub_resource type="Resource" id="Zone_torso"]
script = ExtResource("2_zone")
Id = "torso"
DamageMultiplier = 1.0
Offset = Vector3(0, 3.4, 0)
Radius = 1.6
Height = 7.6
RotationDegrees = Vector3(-87.4, 0, 0)

; The legs and belly: the only part of it a sword reaches. It lies along the stance, not upright.
[sub_resource type="Resource" id="Zone_body"]
script = ExtResource("2_zone")
Id = "body"
DamageMultiplier = 1.0
Offset = Vector3(0, 1.2, -0.4)
Radius = 1.6
Height = 7.6
RotationDegrees = Vector3(-90, 0, 0)

; Along the ground behind it, root to tip.
[sub_resource type="Resource" id="Zone_tail"]
script = ExtResource("2_zone")
Id = "tail"
DamageMultiplier = 0.85
Offset = Vector3(0, 1.8, 5.2)
Radius = 1.05
Height = 6.97
RotationDegrees = Vector3(99.5, 0, 0)

