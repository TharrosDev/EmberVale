[gd_resource type="Resource" script_class="PropertyResource" load_steps=2 format=3 uid="uid://cmbrvlproprcottage"]

[ext_resource type="Script" path="res://src/Housing/PropertyResource.cs" id="1_property"]

; The first holding: a cottage on the south edge of the Ember Crown's square. Gated on the guild's
; standing goblin bounty rather than sold outright — the town sells a house to someone who has done
; something for the town — and then priced on top, so the quest earns you the right to pay rather
; than replacing the payment. 600 gold is reachable but not incidental by the time that bounty is
; done; Phase 38 owns economy balance and this is the sink it will tune.

[resource]
script = ExtResource("1_property")
Id = "property.ember_crown.cottage"
NameKey = "property.cottage.name"
RegionId = "region.ember_crown"
PriceGold = 600
RequiredQuestId = "quest.warband.bounty"
TravelNodeId = "travel.ember_crown.cottage"

; 37C/37D — the yard you may build in, re-centred once the cottage got its own building and room.
; WORLD coordinates: the town hub cell's Center is (0, 0, -10), so a point read out of town_hub.tscn
; needs -10 on z before it goes here. This is the open ground NORTH of the room's doorway (the room
; itself is walled and only 8x6 — a yard inside it would be a yard you cannot turn around in), local
; (-22, -11) => world (-22, -21). Six metres reaches the doorway without swallowing BuildingNW at
; local (-12, -6), and sits well inside the cell's 60x60 floor.
PlacementCenter = Vector3(-22, 0, -21)
PlacementRadius = 6.0
