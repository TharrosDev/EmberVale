[gd_resource type="Resource" script_class="EncounterResource" format=3]

[ext_resource type="Script" path="res://src/World/EncounterResource.cs" id="1_encounter"]

; The Hollow Queen's hostile servants: the dead she commands, who keep the empty roads of her
; realm. Distinct from its residents, who are undying and peaceful and never spawn as encounters.
; All four day phases, because the realm's dusk never ends (presentation only; the clock runs).
[resource]
script = ExtResource("1_encounter")
Id = "encounter.queens_shades"
DisplayName = "Queen's Shades"
EnemyTemplateId = "enemy.grave_shade"
MinCount = 2
MaxCount = 4
SelectionWeight = 0.8
CorruptionChance = 0.1
RegionIds = Array[String](["region.pale_concord"])
AtDawn = true
AtDay = true
AtDusk = true
AtNight = true
