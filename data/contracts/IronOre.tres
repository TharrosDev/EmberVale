[gd_resource type="Resource" script_class="ContractResource" format=3]

[ext_resource type="Script" path="res://src/Economy/ContractResource.cs" id="1_contract"]

; The Emberdeep road wants iron ore hauled up to the Crossway rather than down the shaft.
;
; A Crossway supply contract (Phase 38Q2). Deliver the lot at the caravan board and take the pay.
;
; ⚠️ IT IS NOT A QUEST AND MUST NEVER BECOME ONE. QuestLogPanel deliberately carries no Contracts
; heading — "the journal shows the states the data actually has" — so a haulage job lives and dies on
; the board. No QuestResource, no objective, no journal entry.
;
; ⚠️ THE REWARD IS MEANT TO BEAT THE SHELF, AND --validate REFUSES IT IF IT DOES NOT. A posting worth
; less than a merchant already pays is a longer walk for less money, which the player would only
; discover by doing it.
;
; ⚠️ 38G MOVED THE SHELF UNDER THIS POSTING AND THE VALIDATOR CAUGHT IT ON THE FIRST RUN. Ore is in
; demand at Tarn's Landing now, so the chandler went from paying 80 for 40x to paying 160 — exactly
; what this contract paid, which made it strictly worse than walking the same ore to the coast. 240 is
; the new number, and it is deliberately set against a counter price that can now MOVE: any future
; settlement that authors an ore demand raises the floor under this line again.
;
; ⚠️ AND THE PRICE IS *NOT* WHAT KEEPS IT SAFE — the BOUND is. Buying the goods cheap and delivering
; them dear is a real trade and is meant to be, because a posting can be filled ONCE PER ROTATION and
; ContractLedger is what remembers that. This is the mirror of 38Q's commission rule: that one is
; refused for being too cheap because it could be looped; this one is refused for being too poor
; because it cannot be.

[resource]
script = ExtResource("1_contract")
Id = "contract.crossway.iron_ore"
NameKey = "contract.crossway.iron_ore.name"
ItemId = "item.material.iron_ore"
Quantity = 40
RewardGold = 240
FactionId = "faction.iron_syndicate"
ReputationDelta = 4
