; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Embervale"
config/description="An original first-person open-world fantasy action RPG."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/Core/Events/EventBus.cs"
ServiceLocator="*res://src/Core/Services/ServiceLocator.cs"
GameManager="*res://src/Core/GameManager.cs"
SaveManager="*res://src/Save/SaveManager.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Embervale"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[layer_names]

3d_physics/layer_1="WorldStatic"
3d_physics/layer_2="WorldDynamic"
3d_physics/layer_3="Hurtbox"
3d_physics/layer_4="Hitbox"
3d_physics/layer_5="Player"
3d_physics/layer_6="Enemy"
3d_physics/layer_7="NPC"
3d_physics/layer_8="Projectile"
3d_physics/layer_9="Interaction"
3d_physics/layer_10="CameraBlocker"
3d_physics/layer_11="NavigationObstacle"
3d_physics/layer_12="Water"
3d_physics/layer_13="Trigger"
3d_physics/layer_14="Ragdoll"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

textures/vram_compression/import_etc2_astc=true
